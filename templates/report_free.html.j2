<script>
  (function () {
    const tabs = document.querySelectorAll('[data-engine-tab]');
    const views = document.querySelectorAll('[data-engine-view]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const engine = tab.getAttribute('data-engine-tab');
        tabs.forEach((item) => {
          const isActive = item === tab;
          item.classList.toggle('active', isActive);
          item.setAttribute('aria-selected', String(isActive));
        });
        views.forEach((view) => {
          view.classList.toggle('active', view.getAttribute('data-engine-view') === engine);
        });
      });
    });
  })();
</script>
