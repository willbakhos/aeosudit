{% extends "dashboard/_layout.html.j2" %}
{% block title %}Report unavailable · monitoraeo{% endblock %}
{% block content %}

<p style="margin:0 0 8px;">
  <a href="/dashboard/reports" style="color:var(--blue); font-weight:700; text-decoration:none;">← All reports</a>
  {% if brand %}
    &nbsp;·&nbsp;
    <a href="/dashboard/brands/{{ brand.id }}" style="color:var(--blue); font-weight:700; text-decoration:none;">{{ brand.name }} brand page</a>
  {% endif %}
</p>

<h1 style="margin:8px 0 6px;">{{ brand.name if brand else 'Report' }} — files unavailable</h1>
<p style="color:var(--muted); margin:0 0 28px;">
  Run on {{ run.started_at.strftime('%b %d, %Y · %H:%M') }} UTC ·
  <code style="background:#eef2ff; color:#4338ca; padding:2px 8px; border-radius:6px; font-size:12px;">{{ run.run_id }}</code>
</p>

<div class="card" style="background:linear-gradient(135deg, rgba(245,158,11,.06), rgba(217,119,6,.05)); border:1px solid rgba(245,158,11,.30); padding:24px;">
  <div style="display:flex; gap:16px; align-items:flex-start;">
    <div style="flex:0 0 44px; height:44px; border-radius:50%; background:linear-gradient(135deg, #f59e0b, #d97706); display:flex; align-items:center; justify-content:center;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <div style="flex:1;">
      <h3 style="margin:0 0 6px; font-size:18px;">This report's files were wiped during a recent server update.</h3>
      <p style="margin:0 0 14px; color:var(--ink-2); font-size:14.5px; line-height:1.55;">
        The audit ran successfully and the headline metrics are still in your database, but the full HTML report and raw engine responses are no longer on disk. We're moving audit storage to a persistent volume so this stops happening — in the meantime, re-running the audit will regenerate everything (action plan, hallucination flags, per-query drill-down).
      </p>

      <div style="background:rgba(255,255,255,.7); border-radius:10px; padding:14px 16px; margin-bottom:16px; border:1px solid rgba(15,23,42,.06);">
        <p style="margin:0 0 8px; font-size:12px; font-weight:900; letter-spacing:.06em; text-transform:uppercase; color:var(--muted);">What we still know about this run</p>
        <ul style="margin:0; padding-left:20px; color:var(--ink-2); font-size:13.5px; line-height:1.7;">
          {% if run.visibility_rate is not none %}<li>Visibility: <strong>{{ '%.0f'|format(run.visibility_rate * 100) }}%</strong></li>{% endif %}
          {% if run.citation_rate is not none %}<li>Citation rate: <strong>{{ '%.0f'|format(run.citation_rate * 100) }}%</strong></li>{% endif %}
          {% if run.queries_total %}<li>Queries asked: <strong>{{ run.queries_total }}</strong></li>{% endif %}
          <li>Started: <strong>{{ run.started_at.strftime('%b %d, %Y at %H:%M UTC') }}</strong></li>
        </ul>
      </div>

      {% if brand %}
        <form method="POST" action="/dashboard/brands/{{ brand.id }}/runs" style="display:inline-block; margin:0;">
          <button type="submit" class="btn" style="padding:12px 22px; font-size:14px;">
            Re-run audit for {{ brand.name }} →
          </button>
        </form>
        <a href="/dashboard/brands/{{ brand.id }}" class="btn ghost" style="margin-left:8px; padding:12px 22px; font-size:14px;">Back to brand</a>
      {% else %}
        <a href="/dashboard/reports" class="btn">Back to reports</a>
      {% endif %}

      <p style="margin:14px 0 0; font-size:12.5px; color:var(--muted);">
        Re-running counts against this brand's monthly quota. Questions? <a href="/support" style="color:var(--blue); font-weight:700;">Get help →</a>
      </p>
    </div>
  </div>
</div>

{% endblock %}
