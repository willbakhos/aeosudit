{% extends "dashboard/_layout.html.j2" %}
{% block title %}Monitoring · monitoraeo{% endblock %}
{% block content %}
<h1>Monitoring</h1>
<p class="lede">Each tracked brand is re-audited automatically on the 1st of every month. Subscribers can also trigger one extra manual run per calendar month.</p>

{% if not rows %}
  <div class="empty">
    <p style="margin:0 0 12px;">No brands tracked yet.</p>
    <a class="btn" href="/dashboard/brands/new">Add your first brand →</a>
  </div>
{% else %}
  {% for row in rows %}
    {% set b = row.brand %}
    <div class="card" style="margin-bottom: 16px;">
      <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:18px; flex-wrap:wrap;">
        <div>
          <h2 style="margin:0 0 4px;"><a href="/dashboard/brands/{{ b.id }}" style="color:var(--ink);">{{ b.name }}</a></h2>
          <p style="margin:0; color:var(--muted); font-size:13px;">
            <code>{{ b.domain }}</code>
            {% if b.tier == 'two_engine_monthly' %}
              <span class="pill scheduled" style="margin-left:8px;">Two Engine Monitoring</span>
            {% elif b.tier == 'full_monthly' %}
              <span class="pill scheduled" style="margin-left:8px;">Full Monitoring</span>
            {% else %}
              <span class="pill muted" style="margin-left:8px;">Free dashboard</span>
            {% endif %}
          </p>
        </div>
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-start;">
          <a class="btn ghost" href="/dashboard/brands/{{ b.id }}/queries">Edit monitored questions</a>
          <button type="button" class="btn primary" data-rerun-trigger
                  data-brand-id="{{ b.id }}"
                  data-brand-name="{{ b.name }}"
                  data-tier="{{ b.tier or '' }}"
                  data-quota="{{ row.monthly_quota }}"
                  data-used="{{ row.runs_used }}"
                  data-is-master="{{ '1' if user and user.is_master else '' }}">
            Re-run audit
          </button>
        </div>
      </div>

      <div class="grid cols-3" style="margin-top:18px;">
        <div class="metric" style="background:#f8fafc; border:1px solid var(--line); border-radius:12px;">
          <div class="label">Last run</div>
          <div class="value" style="font-size:18px;">
            {% if b.last_run_at %}
              {{ b.last_run_at.strftime('%Y-%m-%d %H:%M') }} UTC
            {% else %}
              <span style="color:var(--muted);">Never</span>
            {% endif %}
          </div>
        </div>
        <div class="metric" style="background:#f8fafc; border:1px solid var(--line); border-radius:12px;">
          <div class="label">Next scheduled</div>
          <div class="value" style="font-size:18px;">
            {% if b.tier %}
              {{ row.next_scheduled.strftime('%Y-%m-%d %H:%M') }} UTC
            {% else %}
              <span style="color:var(--muted);">Not scheduled</span>
            {% endif %}
          </div>
          <div class="sub">
            {% if b.tier %}
              1st of next month
            {% else %}
              Auto-runs require a monitoring subscription — <a href="#" data-open-upgrade data-brand-name="{{ b.name }}" data-brand-domain="{{ b.domain }}" style="color:var(--blue); font-weight:700;">upgrade</a> to schedule monthly
            {% endif %}
          </div>
        </div>
        <div class="metric" style="background:#f8fafc; border:1px solid var(--line); border-radius:12px;">
          <div class="label">Runs this month</div>
          <div class="value" style="font-size:18px;">{{ b.runs_this_month or 0 }} / {{ row.monthly_quota }}</div>
          <div class="sub">{{ row.runs_left }} left</div>
        </div>
      </div>

      {% if row.trend_runs %}
        <div style="display:flex; align-items:baseline; justify-content:space-between; margin-top:24px; gap:12px; flex-wrap:wrap;">
          <h3 style="margin:0;">Trend</h3>
          <span style="font-size:12px; color:var(--muted); font-weight:700;">{{ row.trend_runs|length }} run{{ '' if row.trend_runs|length == 1 else 's' }}</span>
        </div>
        <div class="metric-tabs" data-target="chart-{{ b.id }}" style="display:flex; gap:6px; margin-top:10px; flex-wrap:wrap; padding:4px; background:rgba(241,245,249,.7); border-radius:12px; width:fit-content;">
          <button type="button" class="metric-tab active" data-metric="visibility">Visibility</button>
          <button type="button" class="metric-tab" data-metric="citation">Citation rate</button>
          <button type="button" class="metric-tab" data-metric="sentiment">Sentiment</button>
          <button type="button" class="metric-tab" data-metric="accuracy">Accuracy</button>
          <button type="button" class="metric-tab" data-metric="hallucinations">Hallucinations</button>
          <button type="button" class="metric-tab" data-metric="sov">Share of Voice</button>
        </div>
        <div class="chart-legend" style="display:flex; gap:14px; align-items:center; margin-top:10px; font-size:12px; color:var(--muted); font-weight:600;">
          <span style="display:inline-flex; align-items:center; gap:6px;">
            <span style="width:10px; height:10px; border-radius:50%; background:#2563eb; display:inline-block;"></span>
            Scheduled run
          </span>
          <span style="display:inline-flex; align-items:center; gap:6px;">
            <span style="width:10px; height:10px; border-radius:50%; background:#f59e0b; display:inline-block; box-shadow:0 0 0 2px rgba(245,158,11,.18);"></span>
            Manual run
          </span>
        </div>
        <div style="position:relative; height:280px; margin-top:8px; background:white; border:1px solid var(--line); border-radius:14px; padding:14px;">
          <canvas id="chart-{{ b.id }}" data-trend='{{ row.trend_json|safe }}'></canvas>
        </div>
      {% else %}
        <p style="margin-top:18px; color:var(--muted); font-size:13px;">No runs yet — first scheduled audit fires on {{ row.next_scheduled.strftime('%b %d') }}.</p>
      {% endif %}
    </div>
  {% endfor %}
{% endif %}

<style>
  .metric-tab {
    appearance: none; border: 0; cursor: pointer;
    padding: 7px 13px; border-radius: 9px;
    background: transparent; color: var(--muted);
    font: inherit; font-size: 12.5px; font-weight: 700;
  }
  .metric-tab:hover { color: var(--ink); background: white; }
  .metric-tab.active { color: var(--ink); background: white; box-shadow: var(--shadow); }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  (function () {
    var METRICS = {
      visibility:     { label: 'Visibility %',     color: '#2563eb', suffix: '%' },
      citation:       { label: 'Citation rate %',  color: '#7c3aed', suffix: '%' },
      sentiment:      { label: 'Sentiment score',  color: '#16a34a', suffix: '%' },
      accuracy:       { label: 'Accuracy score',   color: '#0ea5e9', suffix: '%' },
      hallucinations: { label: 'Hallucination rate %', color: '#dc2626', suffix: '%' },
    };

    function hexToRgba(hex, a) {
      var n = parseInt(hex.replace('#', ''), 16);
      return 'rgba(' + ((n >> 16) & 255) + ',' + ((n >> 8) & 255) + ',' + (n & 255) + ',' + a + ')';
    }

    function lineConfig(data, metric) {
      var m = METRICS[metric];
      var triggers = data.triggers || [];
      var MANUAL = '#f59e0b';
      var pointColors = (data.labels || []).map(function (_, i) {
        return triggers[i] === 'manual' ? MANUAL : m.color;
      });
      var pointRadii = (data.labels || []).map(function (_, i) {
        return triggers[i] === 'manual' ? 6 : 4;
      });
      return {
        type: 'line',
        data: {
          labels: data.labels,
          datasets: [{
            label: m.label,
            data: data[metric] || [],
            borderColor: m.color,
            backgroundColor: hexToRgba(m.color, 0.12),
            borderWidth: 2.5,
            tension: 0.35,
            fill: true,
            spanGaps: true,
            pointRadius: pointRadii,
            pointHoverRadius: 7,
            pointBackgroundColor: pointColors,
            pointBorderColor: pointColors,
            pointBorderWidth: 2,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: 'rgba(15, 23, 42, .94)',
              titleFont: { weight: 700 },
              padding: 10,
              cornerRadius: 8,
              callbacks: {
                label: function (ctx) {
                  if (ctx.parsed.y === null) return m.label + ': —';
                  return m.label + ': ' + ctx.parsed.y + m.suffix;
                },
                afterLabel: function (ctx) {
                  var t = triggers[ctx.dataIndex];
                  return t === 'manual' ? 'Manual re-run' : 'Scheduled run';
                },
              },
            },
          },
          scales: {
            x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 11, weight: 600 } } },
            y: {
              beginAtZero: true,
              max: 100,
              grid: { color: 'rgba(15, 23, 42, .06)' },
              ticks: { color: '#64748b', font: { size: 11 }, callback: function (v) { return v + m.suffix; } },
            },
          },
        },
      };
    }

    function sovConfig(data) {
      return {
        type: 'bar',
        data: {
          labels: data.sov_labels || [],
          datasets: [{
            label: 'Mentions in latest run',
            data: data.sov_counts || [],
            backgroundColor: 'rgba(245, 158, 11, .65)',
            borderColor: '#d97706',
            borderWidth: 1.5,
            borderRadius: 6,
          }],
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: 'rgba(15, 23, 42, .94)',
              titleFont: { weight: 700 },
              padding: 10,
              cornerRadius: 8,
              callbacks: {
                label: function (ctx) { return ctx.parsed.x + ' mention' + (ctx.parsed.x === 1 ? '' : 's'); },
              },
            },
          },
          scales: {
            x: { beginAtZero: true, grid: { color: 'rgba(15, 23, 42, .06)' }, ticks: { color: '#64748b', precision: 0 } },
            y: { grid: { display: false }, ticks: { color: '#334155', font: { size: 12, weight: 700 } } },
          },
        },
      };
    }

    function buildConfig(data, metric) {
      if (metric === 'sov') return sovConfig(data);
      return lineConfig(data, metric);
    }

    var canvases = document.querySelectorAll('canvas[data-trend]');
    var charts = {};
    canvases.forEach(function (canvas) {
      var data = JSON.parse(canvas.getAttribute('data-trend'));
      if (!data.labels || !data.labels.length) return;
      charts[canvas.id] = { data: data, instance: new Chart(canvas, buildConfig(data, 'visibility')) };
    });

    document.querySelectorAll('.metric-tabs').forEach(function (tabs) {
      var targetId = tabs.getAttribute('data-target');
      tabs.querySelectorAll('.metric-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
          tabs.querySelectorAll('.metric-tab').forEach(function (x) { x.classList.remove('active'); });
          btn.classList.add('active');
          var entry = charts[targetId];
          if (!entry) return;
          entry.instance.destroy();
          var metric = btn.getAttribute('data-metric');
          var canvas = document.getElementById(targetId);
          entry.instance = new Chart(canvas, buildConfig(entry.data, metric));
          // Hide the run-type legend on Share of Voice (single-snapshot bar chart).
          var card = canvas.closest('.card');
          var legend = card && card.querySelector('.chart-legend');
          if (legend) legend.style.display = (metric === 'sov') ? 'none' : '';
        });
      });
    });
  })();

</script>

{% include "dashboard/_rerun_modal.html.j2" %}

<!-- Upgrade-to-monitoring modal. Triggered by the 'upgrade' link on
     free-tier brand cards. Renders the two monitoring tiers side-by-side
     and POSTs to /buy when the user picks one, so it stays in-app
     instead of bouncing the user to the pricing page. -->
<div id="upgrade-modal" class="m-overlay" role="dialog" aria-modal="true" aria-labelledby="upgrade-title">
  <div class="m-dialog" style="width: min(720px, 100%);">
    <button type="button" class="m-close" data-upgrade-close aria-label="Close">&times;</button>
    <h3 id="upgrade-title" style="margin:0 0 6px; font-size:21px;">Upgrade <span data-upgrade-brand>this brand</span> to monitoring</h3>
    <p style="margin:0 0 22px; color:var(--muted); font-size:14px;">Both plans include monthly auto-runs, trend charts, an extra manual re-run per month, and the same depth as a one-off audit.</p>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
      <!-- Two Engine Monitoring -->
      <div class="m-plan">
        <div class="m-plan-name">Two Engine Monitoring</div>
        <div class="m-plan-price">$35<small>/mo</small></div>
        <p class="m-plan-tagline">Google AI + ChatGPT — the two engines most buyers use.</p>
        <ul class="m-plan-list">
          <li>Google AI Overviews + ChatGPT</li>
          <li>20 monitored buyer questions</li>
          <li>1 scheduled run + 1 manual re-run per month</li>
          <li>Trend chart over time</li>
          <li>$10 per extra run (1-click)</li>
        </ul>
        <form method="post" action="/buy" style="margin:0;">
          <input type="hidden" name="tier" value="two_engine_monthly">
          <input type="hidden" name="brand_name" data-upgrade-input="brand_name" value="">
          <input type="hidden" name="domain" data-upgrade-input="domain" value="">
          <button type="submit" class="btn primary" style="width:100%;">Start — $35/mo</button>
        </form>
      </div>

      <!-- Full Monitoring -->
      <div class="m-plan featured">
        <span class="m-plan-badge">Best value</span>
        <div class="m-plan-name">Full Monitoring</div>
        <div class="m-plan-price">$95<small>/mo</small></div>
        <p class="m-plan-tagline">All 5 AI engines, monitored monthly.</p>
        <ul class="m-plan-list">
          <li>ChatGPT, Claude, Perplexity, Gemini &amp; Google AI</li>
          <li>40 monitored buyer questions</li>
          <li>1 scheduled run + 1 manual re-run per month</li>
          <li>Per-engine trend charts</li>
          <li>$25 per extra run (1-click)</li>
        </ul>
        <form method="post" action="/buy" style="margin:0;">
          <input type="hidden" name="tier" value="full_monthly">
          <input type="hidden" name="brand_name" data-upgrade-input="brand_name" value="">
          <input type="hidden" name="domain" data-upgrade-input="domain" value="">
          <button type="submit" class="btn primary" style="width:100%;">Start — $95/mo</button>
        </form>
      </div>
    </div>

    <p style="margin:18px 0 0; font-size:12px; color:var(--muted); text-align:center;">
      Cancel anytime from the billing portal. Secure checkout via Stripe.
    </p>
  </div>
</div>

<style>
  .m-plan {
    position: relative;
    background: #f8fafc;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px 18px;
    display: flex; flex-direction: column;
  }
  .m-plan.featured {
    background: linear-gradient(135deg, rgba(37,99,235,.06), rgba(124,58,237,.05));
    border-color: rgba(37,99,235,.25);
  }
  .m-plan-badge {
    position: absolute; top: -10px; right: 14px;
    padding: 4px 10px; border-radius: 999px;
    background: linear-gradient(135deg, var(--blue), var(--purple));
    color: white; font-size: 10px; font-weight: 900;
    letter-spacing: .08em; text-transform: uppercase;
  }
  .m-plan-name { font-size: 15px; font-weight: 900; color: var(--ink); }
  .m-plan-price {
    margin: 6px 0 4px;
    font-size: 32px; font-weight: 900; color: var(--ink);
    letter-spacing: -.03em;
  }
  .m-plan-price small {
    font-size: 13px; font-weight: 700; color: var(--muted); margin-left: 3px;
  }
  .m-plan-tagline {
    margin: 0 0 12px; color: var(--muted); font-size: 13px; line-height: 1.4;
  }
  .m-plan-list {
    list-style: none; padding: 0; margin: 0 0 16px;
    flex: 1;
  }
  .m-plan-list li {
    position: relative; padding: 4px 0 4px 18px;
    font-size: 13px; color: var(--ink);
  }
  .m-plan-list li::before {
    content: "✓"; position: absolute; left: 0; top: 4px;
    color: #16a34a; font-weight: 900;
  }
  @media (max-width: 600px) {
    #upgrade-modal .m-dialog > div[style*="grid"] { grid-template-columns: 1fr !important; }
  }
</style>

<script>
  (function () {
    var modal = document.getElementById('upgrade-modal');
    if (!modal) return;
    var brandSpan = modal.querySelector('[data-upgrade-brand]');
    var nameInputs = modal.querySelectorAll('[data-upgrade-input="brand_name"]');
    var domainInputs = modal.querySelectorAll('[data-upgrade-input="domain"]');

    function open(link) {
      var name = link.getAttribute('data-brand-name') || '';
      var domain = link.getAttribute('data-brand-domain') || '';
      brandSpan.textContent = name || 'this brand';
      nameInputs.forEach(function (i) { i.value = name; });
      domainInputs.forEach(function (i) { i.value = domain; });
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }
    document.querySelectorAll('[data-open-upgrade]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        open(a);
      });
    });
    modal.querySelectorAll('[data-upgrade-close]').forEach(function (el) {
      el.addEventListener('click', close);
    });
    modal.addEventListener('click', function (e) {
      if (e.target === modal) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('open')) close();
    });
  })();
</script>

<div class="card" style="margin-top:32px; background:#f0f9ff; border-color:rgba(37,99,235,.18);">
  <h3 style="margin-top:0;">How monitoring works</h3>
  <p style="color:var(--ink-2); font-size:14px; margin:8px 0;">We automatically re-audit each of your brands on the <strong>1st of every month</strong>, then save the report and update your trend chart. You'll get the same depth of analysis as a one-off audit — just running on autopilot in the background.</p>
  <p style="color:var(--muted); font-size:13px; margin:8px 0 0;">Each subscription includes <strong>2 audit runs per month</strong>: the automatic one on the 1st, plus one extra you can trigger any time with the "Run audit now" button (useful right after a site change). The counter resets on the 1st when the new month starts.</p>
</div>
{% endblock %}
