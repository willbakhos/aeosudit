{% extends "dashboard/_layout.html.j2" %}
{% block title %}Monitored questions · {{ brand.name }} · monitoraeo{% endblock %}
{% block content %}
<p style="margin:0 0 8px;">
  <a href="/dashboard/monitoring">← Monitoring</a>
  &nbsp;·&nbsp;
  <a href="/dashboard/brands/{{ brand.id }}">{{ brand.name }} brand page</a>
</p>
<h1 style="margin:0 0 6px;">Monitored questions</h1>
<p class="lede" style="margin:0 0 22px;">
  These are the buyer-facing questions the cron audits each month for
  <strong>{{ brand.name }}</strong> across every engine on your tier. One question per line.
  {% if limit > 0 %}
    Your tier allows up to <strong>{{ limit }}</strong>.
  {% endif %}
</p>

{% if saved %}
  <div class="card" style="background:#ecfdf5; border-color:rgba(22,163,74,.20); margin-bottom:18px;">
    <strong style="color:var(--success);">Saved.</strong>
    <span style="color:var(--muted); font-size:13px; margin-left:6px;">
      Your next monitoring run will use this question list.
    </span>
  </div>
{% endif %}

{% if error == 'over_limit' %}
  <div class="card" style="background:#fef2f2; border-color:rgba(220,38,38,.18); margin-bottom:18px;">
    <strong style="color:var(--danger);">Over the tier limit.</strong>
    <span style="color:var(--muted); font-size:13px; margin-left:6px;">
      Trim the list to {{ limit }} or fewer and save again.
    </span>
  </div>
{% elif error == 'needs_monitoring_tier' %}
  <div class="card" style="background:#fffbeb; border-color:rgba(217,119,6,.20); margin-bottom:18px;">
    <strong style="color:var(--warning);">No monitoring subscription on this brand.</strong>
    <span style="color:var(--muted); font-size:13px; margin-left:6px;">
      Editing the monitored question list requires a Two Engine or Full Monitoring plan.
    </span>
  </div>
{% endif %}

<form method="post" action="/dashboard/brands/{{ brand.id }}/queries" class="card">
  <div style="display:flex; align-items:center; justify-content:space-between; gap:18px; margin-bottom:10px;">
    <label for="queries" style="margin:0; font-weight:800;">Questions (one per line)</label>
    <span style="font-size:12px; color:var(--muted); font-weight:700;">
      <span id="counter">{{ query_count }}</span>
      {% if limit > 0 %}
        / <strong>{{ limit }}</strong>
      {% endif %}
    </span>
  </div>
  <textarea
    id="queries"
    name="queries"
    rows="16"
    style="width:100%; font-family: ui-monospace, Menlo, monospace; font-size:13.5px; line-height:1.55; padding:14px; border-radius:12px; border:1px solid var(--line); background:#fafbfc; resize:vertical;"
    placeholder="What is {{ brand.name }}?&#10;{{ brand.name }} vs competitors&#10;Best alternatives to {{ brand.name }}&#10;…"
  >{{ queries_text }}</textarea>

  <div style="margin-top:14px; display:flex; gap:10px; flex-wrap:wrap;">
    <button class="btn" type="submit">Save</button>
    <a class="btn ghost" href="/dashboard/brands/{{ brand.id }}">Cancel</a>
  </div>

  <p style="margin:18px 0 0; font-size:12px; color:var(--muted);">
    Tip: think like a buyer who's never heard of {{ brand.name }}. The cron asks each
    engine these questions verbatim and records whether your brand shows up, who
    gets named instead, and which sources get cited.
  </p>
</form>

<script>
  (function () {
    var ta = document.getElementById("queries");
    var counter = document.getElementById("counter");
    function update() {
      var n = (ta.value || "")
        .split("\n")
        .map(function (s) { return s.trim(); })
        .filter(function (s) { return s.length > 0; }).length;
      counter.textContent = n;
    }
    ta.addEventListener("input", update);
    update();
  })();
</script>
{% endblock %}
