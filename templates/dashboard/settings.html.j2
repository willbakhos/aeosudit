{% extends "dashboard/_layout.html.j2" %}
{% block title %}Settings · monitoraeo{% endblock %}
{% block content %}
<h1>Settings</h1>
<p class="lede">Profile, billing and team management.</p>

<div class="subtabs">
  <a href="/dashboard/settings/profile" class="subtab {% if sub == 'profile' %}active{% endif %}">Profile</a>
  <a href="/dashboard/settings/billing" class="subtab {% if sub == 'billing' %}active{% endif %}">Billing</a>
  <a href="/dashboard/settings/team" class="subtab {% if sub == 'team' %}active{% endif %}">Team</a>
</div>

{% if sub == 'profile' %}
  <div class="card">
    <h2 style="margin-top:0;">Profile</h2>
    <div style="display:flex; align-items:center; gap:16px; margin-bottom:24px;">
      <div style="width:64px; height:64px; border-radius:50%; display:grid; place-items:center;
                  color:white; background:linear-gradient(135deg, var(--blue), var(--purple));
                  font-size:24px; font-weight:900;">
        {{ (user.email or '?')[0]|upper }}
      </div>
      <div>
        <div style="font-size:17px; font-weight:800;">{{ user.email }}</div>
        <div style="color:var(--muted); font-size:13px;">User ID: <code>{{ user.id[:8] }}…</code></div>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; max-width:640px;">
      <div>
        <label>Email</label>
        <input type="email" value="{{ user.email }}" disabled style="background:#f8fafc; color:var(--muted);">
        <p style="color:var(--muted); font-size:12px; margin:4px 0 0;">Email changes are managed by Supabase.</p>
      </div>
      <div>
        <label>Brands tracked</label>
        <input type="text" value="{{ brand_count }}" disabled style="background:#f8fafc; color:var(--muted);">
      </div>
    </div>

    <h3 style="margin-top:32px;">Account</h3>
    <p style="color:var(--muted); font-size:14px;">Need to change your email or delete your account?
      <a href="/support">Contact support</a> — we'll handle it via Supabase.</p>
  </div>

{% elif sub == 'billing' %}
  <div class="card">
    <h2 style="margin-top:0;">Billing</h2>
    <p class="lede">Subscriptions, invoices and payment methods.</p>

    <div style="padding:24px; background:#fef9c3; border:1px solid #fde68a; border-radius:12px; color:#854d0e;">
      <strong>Stripe checkout isn't wired up yet.</strong>
      <p style="margin:8px 0 0; font-size:14px;">When live, you'll manage your subscription, see your invoice history, and update card details here.</p>
    </div>

    <h3 style="margin-top:28px;">Current plan</h3>
    <div style="padding:18px; background:#f8fafc; border:1px solid var(--line); border-radius:12px;">
      <div style="font-weight:800; font-size:16px;">Free dashboard</div>
      <p style="margin:6px 0 0; color:var(--muted); font-size:13px;">No active subscription. Upgrade to enable scheduled monthly audits across all your brands.</p>
    </div>

    <h3 style="margin-top:24px;">Upgrade options</h3>
    <div class="grid cols-2">
      <div class="card" style="margin:0; padding:18px;">
        <div style="font-size:11px; font-weight:900; color:var(--muted); text-transform:uppercase; letter-spacing:.06em;">Two Engine Monitoring</div>
        <div style="font-size:30px; font-weight:950; letter-spacing:-.03em;">$35<small style="font-size:14px; color:var(--muted); font-weight:700;">/mo</small></div>
        <p style="color:var(--muted); font-size:13px; margin:6px 0 12px;">Google AI + ChatGPT, monthly cron audits, trend chart.</p>
        <a href="/pricing" class="btn ghost" style="font-size:13px; padding:8px 14px;">See details</a>
      </div>
      <div class="card" style="margin:0; padding:18px;">
        <div style="font-size:11px; font-weight:900; color:var(--muted); text-transform:uppercase; letter-spacing:.06em;">Full Monitoring</div>
        <div style="font-size:30px; font-weight:950; letter-spacing:-.03em;">$95<small style="font-size:14px; color:var(--muted); font-weight:700;">/mo</small></div>
        <p style="color:var(--muted); font-size:13px; margin:6px 0 12px;">All 5 engines tracked monthly, per-engine trends.</p>
        <a href="/pricing" class="btn ghost" style="font-size:13px; padding:8px 14px;">See details</a>
      </div>
    </div>
  </div>

{% elif sub == 'team' %}
  <div class="card">
    <h2 style="margin-top:0;">Team</h2>
    <p class="lede">Invite teammates to view your brands and reports.</p>

    <div style="padding:24px; background:#fef9c3; border:1px solid #fde68a; border-radius:12px; color:#854d0e;">
      <strong>Multi-user teams aren't built yet.</strong>
      <p style="margin:8px 0 0; font-size:14px;">Coming soon: invite teammates by email, set role (Owner / Editor / Viewer), see audit log of who ran what.</p>
    </div>

    <h3 style="margin-top:28px;">Current members</h3>
    <div class="card" style="margin:0; padding:0;">
      <table>
        <thead>
          <tr><th>Member</th><th>Role</th><th>Status</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:30px; height:30px; border-radius:50%; display:grid; place-items:center;
                            color:white; background:linear-gradient(135deg, var(--blue), var(--purple));
                            font-size:12px; font-weight:900;">
                  {{ (user.email or '?')[0]|upper }}
                </div>
                <div>
                  <div style="font-weight:700;">{{ user.email }}</div>
                  <div style="color:var(--muted); font-size:12px;">You</div>
                </div>
              </div>
            </td>
            <td><span class="pill ok">Owner</span></td>
            <td><span class="pill ok">Active</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
{% endif %}
{% endblock %}
