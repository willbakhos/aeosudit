{% extends "dashboard/_layout.html.j2" %}
{% block title %}Team invite · monitoraeo{% endblock %}
{% block content %}
{% if state == 'accepted' %}
  <div class="card" style="max-width:560px; margin:40px auto;">
    <h1 style="margin-top:0;">Welcome to the team</h1>
    <p>You're now connected to the workspace that invited you.</p>
    <p style="margin-top:24px;">
      <a class="btn" href="/dashboard">Open the dashboard →</a>
    </p>
  </div>
{% elif state == 'email_mismatch' %}
  <div class="card" style="max-width:560px; margin:40px auto; background:#fef9c3; border-color:#fde68a;">
    <h1 style="margin-top:0;">Wrong account</h1>
    <p>This invite was sent to <strong>{{ invite.email }}</strong>, but you're signed in as <strong>{{ user.email }}</strong>.</p>
    <p style="margin-top:18px;">
      <form method="post" action="/dashboard/logout" style="margin:0;">
        <button class="btn" type="submit">Sign out and try again</button>
      </form>
    </p>
  </div>
{% else %}
  <div class="card" style="max-width:560px; margin:40px auto;">
    <h1 style="margin-top:0;">Invite not found</h1>
    <p>This invite has expired, been revoked, or already been used.</p>
    <p style="margin-top:18px;"><a class="btn" href="/">Back to home</a></p>
  </div>
{% endif %}
{% endblock %}
