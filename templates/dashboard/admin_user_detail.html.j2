{% extends "dashboard/_layout.html.j2" %}
{% block title %}Admin · {{ target.email }} · monitoraeo{% endblock %}
{% block content %}
{% set q_error = flash_error %}

<p style="margin:0 0 8px;">
  <a href="/dashboard/admin">← All users</a>
</p>
<div style="display:flex; align-items:flex-end; gap:18px; flex-wrap:wrap; margin-bottom:8px;">
  <div style="flex:1; min-width:240px;">
    <h1 style="margin:0;">
      {{ target.email }}
      {% if is_self %}
        <span style="margin-left:8px; padding:3px 9px; border-radius:999px; background:#dbeafe; color:#1d4ed8; font-size:11px; font-weight:900; letter-spacing:.06em; text-transform:uppercase;">You</span>
      {% endif %}
    </h1>
    <p class="lede" style="margin:4px 0 0;">
      User <code>{{ target.id }}</code> · signed up
      {% if target.created_at %}{{ target.created_at.strftime('%b %d, %Y') }}{% else %}—{% endif %}
      · last sign-in
      {% if target.last_sign_in_at %}{{ target.last_sign_in_at.strftime('%b %d, %Y') }}{% else %}never{% endif %}
    </p>
  </div>
</div>

{% if q_error == 'cant_delete_self' %}
  <div class="card" style="background:#fef2f2; border-color:rgba(220,38,38,.18); margin:16px 0;">
    <strong style="color:var(--danger);">You can't delete your own master account from this panel.</strong>
  </div>
{% endif %}

<div class="grid cols-3" style="margin-top:18px;">
  <div class="card metric"><div class="label">Brands</div><div class="value">{{ brands|length }}</div></div>
  <div class="card metric"><div class="label">Audit runs</div><div class="value">{{ run_total }}</div></div>
  <div class="card metric"><div class="label">Active subs</div><div class="value">
    {{ brands|selectattr('tier')|list|length }}
  </div></div>
</div>

<h2 style="margin-top:32px;">Brands</h2>
{% if brands %}
  <div class="card" style="padding:0; overflow:hidden;">
    <table style="width:100%;">
      <thead>
        <tr><th>Brand</th><th>Domain</th><th>Tier</th><th>Last run</th><th>Next scheduled</th><th></th></tr>
      </thead>
      <tbody>
        {% for b in brands %}
          <tr>
            <td>
              <div style="font-weight:700;">{{ b.name }}</div>
              <div style="color:var(--muted); font-size:12px;">{{ b.locale_country }}/{{ b.locale_language }}</div>
            </td>
            <td><code>{{ b.domain }}</code></td>
            <td>
              {% if b.tier %}
                <span class="pill scheduled">{{ tier_plans.get(b.tier, {}).get('label', b.tier) }}</span>
              {% else %}
                <span class="pill muted">Free</span>
              {% endif %}
            </td>
            <td style="color:var(--muted); font-size:13px;">
              {% if b.last_run_at %}{{ b.last_run_at.strftime('%Y-%m-%d') }}{% else %}—{% endif %}
            </td>
            <td style="color:var(--muted); font-size:13px;">
              {% if b.next_scheduled_run %}{{ b.next_scheduled_run.strftime('%Y-%m-%d') }}{% else %}—{% endif %}
            </td>
            <td>
              <a href="/dashboard/brands/{{ b.id }}" class="btn ghost" style="padding:6px 10px; font-size:12px;">View</a>
              <a href="/dashboard/brands/{{ b.id }}/edit" class="btn ghost" style="padding:6px 10px; font-size:12px;">Edit</a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <p style="color:var(--muted); font-size:12px; margin:8px 0 0;">
    Click into any brand to run an extra audit (your master engine-picker
    appears) or change their tier as a comp.
  </p>
{% else %}
  <p style="color:var(--muted);">This user hasn't added any brands yet.</p>
{% endif %}

<h2 style="margin-top:32px;">Recent audit runs</h2>
{% if runs %}
  <div class="card" style="padding:0; overflow:hidden;">
    <table style="width:100%;">
      <thead>
        <tr><th>When</th><th>Run ID</th><th>Status</th><th>Visibility</th><th>Citation</th><th></th></tr>
      </thead>
      <tbody>
        {% for r in runs %}
          <tr>
            <td style="font-size:13px;">{{ r.started_at.strftime('%Y-%m-%d %H:%M') }} UTC</td>
            <td><code>{{ r.run_id }}</code></td>
            <td>
              {% if r.status == 'complete' %}
                <span class="pill ok">complete</span>
              {% elif r.status == 'failed' %}
                <span class="pill" style="background:#fef2f2; color:#991b1b;">failed</span>
              {% else %}
                <span class="pill" style="background:#fef9c3; color:#854d0e;">{{ r.status }}</span>
              {% endif %}
            </td>
            <td>{% if r.visibility_rate is not none %}{{ '%.0f'|format(r.visibility_rate * 100) }}%{% else %}—{% endif %}</td>
            <td>{% if r.citation_rate is not none %}{{ '%.0f'|format(r.citation_rate * 100) }}%{% else %}—{% endif %}</td>
            <td>
              {% if r.status == 'complete' %}
                <a href="/dashboard/reports/{{ r.run_id }}" class="btn ghost" style="padding:6px 10px; font-size:12px;">Open</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% if run_total > runs|length %}
    <p style="color:var(--muted); font-size:12px; margin:8px 0 0;">
      Showing the {{ runs|length }} most recent of {{ run_total }} runs.
    </p>
  {% endif %}
{% else %}
  <p style="color:var(--muted);">No audit runs yet.</p>
{% endif %}

<h2 style="margin-top:32px; color:var(--danger);">Danger zone</h2>
<div class="card" style="border-color:rgba(220,38,38,.20); background:#fef2f2;">
  <h3 style="margin:0 0 8px; color:var(--danger);">Delete this account</h3>
  <p style="margin:0 0 14px; color:var(--ink-2); font-size:14px;">
    Removes the Supabase auth user, every brand they added,
    every audit run and every team invite they sent or received.
    Their cached report HTML on disk stays (we don't currently garbage-collect those).
    <strong>This cannot be undone.</strong>
  </p>
  <form method="post" action="/dashboard/admin/users/{{ target.id }}/delete"
        onsubmit="return confirm('Permanently delete {{ target.email }} and all their data? This cannot be undone.');">
    <button type="submit" class="btn" {% if is_self %}disabled style="opacity:.5; cursor:not-allowed;"{% else %}style="background:var(--danger); border:0; color:white;"{% endif %}>
      {% if is_self %}Cannot delete yourself{% else %}Delete account permanently{% endif %}
    </button>
  </form>
</div>
{% endblock %}
