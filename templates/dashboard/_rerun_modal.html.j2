<!-- Re-run audit modal. Included from monitoring.html.j2 and brand_detail.html.j2.
     Any element with [data-rerun-trigger] + data-brand-id / data-brand-name /
     data-tier / data-quota / data-used / data-is-master opens it. -->
<div id="rerun-modal" class="m-overlay" role="dialog" aria-modal="true" aria-labelledby="rerun-title">
  <div class="m-dialog">
    <button type="button" class="m-close" data-close aria-label="Close">&times;</button>
    <h3 id="rerun-title" data-modal-title>Re-run audit</h3>
    <p class="m-quota"><span class="dot"></span><span data-modal-quota></span></p>
    <form method="post" action="">
      <div data-engine-group class="m-engine-group">
        <span class="m-label">Engines</span>
        <label class="m-radio"><input type="radio" name="engine_set" value="google_only"> Google AI only</label>
        <label class="m-radio"><input type="radio" name="engine_set" value="two_engine"> Google AI + ChatGPT</label>
        <label class="m-radio"><input type="radio" name="engine_set" value="full" checked> All 5 engines</label>
      </div>
      <p data-quota-warning class="m-warn"></p>
      <div data-extra-section class="m-extra" style="display:none;">
        <p class="m-extra-copy">
          Need another run this month? Add one matching your subscription —
          <strong data-extra-engines>Google AI + ChatGPT</strong>.
        </p>
        <button type="button" class="btn primary m-extra-btn" data-buy-extra>
          <span data-extra-label>Buy extra 2-engine run</span> — $<span data-extra-price>10</span>
        </button>
        <p class="m-extra-status" data-extra-status></p>
        <p class="m-extra-upgrade" data-extra-upgrade style="display:none;">
          Want all 5 engines per extra run? <a href="/pricing">Upgrade to Full Monitoring</a> ($95/mo, $25 per extra).
        </p>
      </div>
      <label data-master-override class="m-master">
        <input type="checkbox" name="force" value="1"> Master: override quota
      </label>
      <div class="m-actions">
        <button type="button" class="btn ghost" data-close>Cancel</button>
        <button type="submit" class="btn primary" data-submit>Run audit</button>
      </div>
    </form>
  </div>
</div>

<style>
  .m-overlay {
    position: fixed; inset: 0; z-index: 1000;
    background: rgba(15,23,42,.55); backdrop-filter: blur(4px);
    display: none; align-items: center; justify-content: center;
    padding: 20px;
  }
  .m-overlay.open { display: flex; }
  .m-dialog {
    position: relative;
    width: min(460px, 100%);
    background: white; border-radius: 18px;
    padding: 28px 26px 22px;
    box-shadow: 0 24px 60px rgba(15,23,42,.30);
    border: 1px solid var(--line);
    animation: m-pop .18s ease-out;
  }
  @keyframes m-pop {
    from { transform: scale(.96); opacity: 0; }
    to   { transform: scale(1);    opacity: 1; }
  }
  .m-close {
    position: absolute; top: 12px; right: 14px;
    background: transparent; border: 0; cursor: pointer;
    font-size: 26px; line-height: 1; color: var(--muted);
    width: 32px; height: 32px; border-radius: 8px;
  }
  .m-close:hover { background: rgba(15,23,42,.06); color: var(--ink); }
  #rerun-title { margin: 0 0 6px; font-size: 19px; letter-spacing: -.01em; }
  .m-quota {
    display: flex; align-items: center; gap: 8px;
    margin: 0 0 18px; color: var(--muted); font-size: 13px; font-weight: 700;
  }
  .m-quota .dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--blue);
  }
  .m-engine-group {
    display: flex; flex-direction: column; gap: 6px;
    padding: 14px; border: 1px solid var(--line); border-radius: 12px;
    background: #f8fafc; margin-bottom: 14px;
  }
  .m-label {
    font-size: 11px; font-weight: 900; letter-spacing: .08em;
    text-transform: uppercase; color: var(--muted); margin-bottom: 4px;
  }
  .m-radio {
    display: flex; align-items: center; gap: 9px;
    font-size: 14px; color: var(--ink); cursor: pointer;
    padding: 4px 0;
  }
  .m-radio input { accent-color: var(--blue); }
  .m-warn {
    margin: 0 0 14px; padding: 10px 12px;
    background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412;
    border-radius: 10px; font-size: 13px; line-height: 1.45; font-weight: 600;
    display: none;
  }
  .m-master {
    display: flex; align-items: center; gap: 8px;
    margin: 0 0 14px; font-size: 13px; color: var(--muted); font-weight: 700;
  }
  .m-master input { accent-color: var(--blue); }
  .m-extra {
    margin: 0 0 14px; padding: 14px;
    background: linear-gradient(135deg, rgba(37,99,235,.06), rgba(124,58,237,.04));
    border: 1px solid rgba(37,99,235,.18);
    border-radius: 12px;
  }
  .m-extra-copy {
    margin: 0 0 10px; font-size: 13px; color: var(--ink); font-weight: 600;
  }
  .m-extra-btn { width: 100%; padding: 10px; }
  .m-extra-btn[disabled] { opacity: .6; cursor: progress; }
  .m-extra-status {
    margin: 8px 0 0; font-size: 12px; color: var(--muted); min-height: 16px;
  }
  .m-extra-status.error { color: #b91c1c; }
  .m-extra-status.success { color: #15803d; }
  .m-extra-upgrade {
    margin: 10px 0 0; padding-top: 10px;
    border-top: 1px dashed rgba(37,99,235,.20);
    font-size: 12px; color: var(--muted);
  }
  .m-extra-upgrade a { color: var(--blue); font-weight: 800; }
  .m-actions {
    display: flex; gap: 8px; justify-content: flex-end;
    padding-top: 12px; border-top: 1px solid var(--line);
  }
  .m-actions .btn { padding: 9px 18px; }
  .m-actions .btn[disabled] { opacity: .55; cursor: not-allowed; }
</style>

<script>
  (function () {
    var modal = document.getElementById('rerun-modal');
    if (!modal) return;
    var form = modal.querySelector('form');
    var titleEl = modal.querySelector('[data-modal-title]');
    var quotaEl = modal.querySelector('[data-modal-quota]');
    var engineGroup = modal.querySelector('[data-engine-group]');
    var overrideRow = modal.querySelector('[data-master-override]');
    var overrideCheckbox = modal.querySelector('input[name="force"]');
    var submitBtn = modal.querySelector('[data-submit]');
    var quotaWarn = modal.querySelector('[data-quota-warning]');
    var extraSection = modal.querySelector('[data-extra-section]');
    var extraBtn = modal.querySelector('[data-buy-extra]');
    var extraPrice = modal.querySelector('[data-extra-price]');
    var extraLabel = modal.querySelector('[data-extra-label]');
    var extraEngines = modal.querySelector('[data-extra-engines]');
    var extraStatus = modal.querySelector('[data-extra-status]');
    var extraUpgrade = modal.querySelector('[data-extra-upgrade]');
    var currentTrigger = null;

    // Per-tier add-on spec — must mirror EXTRA_RUN_PRICE_USD on the server.
    // The engine list is locked to the subscription so a $35 subscriber can
    // never get a 5-engine extra run; they'd have to upgrade their plan first.
    var EXTRA_SPEC = {
      two_engine_monthly: {
        price: 10,
        label: 'Buy extra 2-engine run',
        engines: 'Google AI + ChatGPT',
        canUpgrade: true,
      },
      full_monthly: {
        price: 25,
        label: 'Buy extra 5-engine run',
        engines: 'all 5 engines (ChatGPT, Claude, Perplexity, Gemini, Google AI)',
        canUpgrade: false,
      },
    };

    function open(trigger) {
      currentTrigger = trigger;
      var brandId   = trigger.getAttribute('data-brand-id');
      var brandName = trigger.getAttribute('data-brand-name');
      var tier      = trigger.getAttribute('data-tier');
      var quota     = parseInt(trigger.getAttribute('data-quota'), 10) || 1;
      var used      = parseInt(trigger.getAttribute('data-used'), 10) || 0;
      var isMaster  = trigger.getAttribute('data-is-master') === '1';
      var atQuota   = used >= quota;
      var spec      = EXTRA_SPEC[tier];
      var extraOk   = atQuota && spec != null;

      form.action = '/dashboard/brands/' + brandId + '/runs';
      titleEl.textContent = 'Re-run audit for ' + brandName;
      quotaEl.textContent = used + ' of ' + quota + ' monthly run' + (quota === 1 ? '' : 's') + ' used';
      engineGroup.style.display = isMaster ? '' : 'none';
      overrideRow.style.display = (isMaster && atQuota) ? '' : 'none';
      overrideCheckbox.checked = false;

      if (atQuota) {
        quotaWarn.style.display = '';
        quotaWarn.textContent = tier
          ? 'Monthly quota reached. Next scheduled run fires on the 1st.'
          : "You've used your free monthly run. Upgrade to a monitoring plan for additional runs.";
      } else {
        quotaWarn.style.display = 'none';
      }

      if (extraOk) {
        extraSection.style.display = '';
        // Re-query the spans every open in case a previous failure path
        // re-wrote the button's innerHTML and detached the cached refs.
        extraLabel = extraBtn.querySelector('[data-extra-label]');
        extraPrice = extraBtn.querySelector('[data-extra-price]');
        extraPrice.textContent = spec.price;
        extraLabel.textContent = spec.label;
        extraEngines.textContent = spec.engines;
        extraUpgrade.style.display = spec.canUpgrade ? '' : 'none';
        extraStatus.textContent = '';
        extraStatus.className = 'm-extra-status';
        extraBtn.disabled = false;
        extraBtn.dataset.brandId = brandId;
      } else {
        extraSection.style.display = 'none';
      }

      updateSubmitState(atQuota, isMaster);
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      modal.classList.remove('open');
      document.body.style.overflow = '';
      currentTrigger = null;
    }

    function updateSubmitState(atQuota, isMaster) {
      var canRun = !atQuota || (isMaster && overrideCheckbox.checked);
      submitBtn.disabled = !canRun;
      submitBtn.textContent = canRun ? 'Run audit' : 'Quota reached';
    }

    document.querySelectorAll('[data-rerun-trigger]').forEach(function (btn) {
      btn.addEventListener('click', function () { open(btn); });
    });
    modal.querySelectorAll('[data-close]').forEach(function (el) {
      el.addEventListener('click', close);
    });
    modal.addEventListener('click', function (e) {
      if (e.target === modal) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('open')) close();
    });
    if (overrideCheckbox) {
      overrideCheckbox.addEventListener('change', function () {
        if (!currentTrigger) return;
        var quota = parseInt(currentTrigger.getAttribute('data-quota'), 10) || 1;
        var used  = parseInt(currentTrigger.getAttribute('data-used'), 10) || 0;
        updateSubmitState(used >= quota, true);
      });
    }

    if (extraBtn) {
      extraBtn.addEventListener('click', async function () {
        var brandId = extraBtn.dataset.brandId;
        if (!brandId) return;
        extraBtn.disabled = true;
        extraBtn.textContent = 'Charging your card…';
        extraStatus.className = 'm-extra-status';
        extraStatus.textContent = '';
        try {
          var resp = await fetch('/dashboard/brands/' + brandId + '/runs/buy-extra', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'accept': 'application/json' },
          });
          var data = await resp.json().catch(function () { return {}; });
          if (resp.ok && data.ok) {
            extraStatus.className = 'm-extra-status success';
            extraStatus.textContent = 'Payment confirmed. Audit is running — redirecting…';
            setTimeout(function () {
              window.location.href = '/dashboard/brands/' + brandId + '?extra_paid=1';
            }, 900);
            return;
          }
          if (resp.status === 402 && data.needs_auth && data.checkout_url) {
            // 3DS required — open Stripe-hosted confirmation page in a new tab.
            window.open(data.checkout_url, '_blank', 'noopener');
            extraStatus.className = 'm-extra-status';
            extraStatus.textContent = 'Your card needs verification. Complete it in the new tab — the audit will start automatically.';
            extraBtn.textContent = 'Waiting for verification…';
            return;
          }
          extraStatus.className = 'm-extra-status error';
          extraStatus.textContent = data.error || 'Payment failed. Please try again or update your card.';
          extraBtn.disabled = false;
          extraBtn.innerHTML = '<span data-extra-label>' + extraLabel.textContent +
            '</span> — $<span data-extra-price>' + extraPrice.textContent + '</span>';
        } catch (e) {
          extraStatus.className = 'm-extra-status error';
          extraStatus.textContent = 'Network error. Please try again.';
          extraBtn.disabled = false;
          extraBtn.innerHTML = '<span data-extra-label>' + extraLabel.textContent +
            '</span> — $<span data-extra-price>' + extraPrice.textContent + '</span>';
        }
      });
    }
  })();

  // Flash toasts driven by query params the server sets on redirect.
  (function () {
    var params = new URLSearchParams(window.location.search);
    var msg = null, bg = '#0f172a';
    if (params.get('quota_reached')) {
      msg = 'Monthly quota reached for that brand — no new run was started.';
    } else if (params.get('extra_paid')) {
      msg = '✓ Payment confirmed — your extra audit run is now in progress.';
      bg = '#15803d';
    } else if (params.get('extra_failed')) {
      msg = 'Payment didn’t complete — no extra run was added. Please try again.';
      bg = '#b91c1c';
    }
    if (!msg) return;
    var toast = document.createElement('div');
    toast.textContent = msg;
    toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:' + bg + ';color:white;padding:12px 18px;border-radius:12px;font-size:14px;font-weight:700;box-shadow:0 12px 28px rgba(15,23,42,.30);z-index:1001;max-width:90vw;text-align:center;';
    document.body.appendChild(toast);
    setTimeout(function () { toast.remove(); }, 4500);
  })();
</script>
