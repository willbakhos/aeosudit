{% extends "dashboard/_layout.html.j2" %}
{% block title %}Report · {{ brand.name if brand else run.run_id }} · monitoraeo{% endblock %}
{% block extra_css %}
  /* The wrapper layout for an embedded report — sidebar on the left, iframe on the right.
     The .shell from the parent layout gets widened so the report has more breathing room. */
  .shell { max-width: 1320px; }

  .report-wrap {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 22px;
    margin-top: 18px;
    min-height: calc(100vh - 200px);
  }
  .report-side {
    position: sticky; top: 80px;
    align-self: start;
    padding: 18px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow);
  }
  .report-side .crumb {
    margin-bottom: 14px; padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    font-size: 12px; color: var(--muted); font-weight: 700;
  }
  .report-side .crumb strong { display: block; color: var(--ink); font-size: 14px; margin-top: 4px; }
  .report-side h4 {
    margin: 0 0 8px;
    font-size: 11px; font-weight: 900; letter-spacing: .08em;
    text-transform: uppercase; color: var(--muted);
  }
  .report-side nav { display: flex; flex-direction: column; }
  .report-side nav a {
    padding: 8px 10px; border-radius: 8px;
    color: var(--ink-2); font-size: 13.5px; font-weight: 600;
    text-decoration: none;
  }
  .report-side nav a:hover { background: rgba(37,99,235,.08); color: var(--blue); }
  .report-side nav a.active { background: rgba(37,99,235,.10); color: var(--blue); }
  .report-side .external {
    margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line);
    font-size: 12px;
  }
  .report-side .external a { color: var(--muted); font-weight: 700; }

  .report-frame-wrap {
    background: white;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow);
    min-height: calc(100vh - 200px);
  }
  .report-frame-wrap iframe {
    display: block;
    width: 100%;
    height: calc(100vh - 200px);
    border: 0;
    background: white;
  }
  @media (max-width: 900px) {
    .report-wrap { grid-template-columns: 1fr; }
    .report-side { position: static; }
  }
{% endblock %}
{% block content %}
<p style="margin:0 0 8px;">
  <a href="/dashboard/reports">← All reports</a>
  {% if brand %}
    &nbsp;·&nbsp;
    <a href="/dashboard/brands/{{ brand.id }}">{{ brand.name }} brand page</a>
  {% endif %}
</p>
<h1 style="margin:0 0 4px;">{{ brand.name if brand else 'Report' }} audit</h1>
<p class="lede" style="margin:0;">
  Run on
  {% if run.finished_at %}{{ run.finished_at.strftime('%b %d, %Y · %H:%M UTC') }}
  {% else %}{{ run.started_at.strftime('%b %d, %Y · %H:%M UTC') }}{% endif %}
  · <code>{{ run.run_id }}</code>
</p>

<div class="report-wrap">
  <aside class="report-side">
    <div class="crumb">
      Viewing<strong>{{ brand.name if brand else run.run_id }}</strong>
    </div>
    <h4>Jump to section</h4>
    <nav id="reportNav">
      {% for s in sections %}
        <a href="/report/{{ run.run_id }}#{{ s.anchor }}" data-anchor="{{ s.anchor }}" data-fallback="{{ s.fallback }}" target="reportFrame">{{ s.label }}</a>
      {% endfor %}
    </nav>
    <div class="external">
      <a href="/report/{{ run.run_id }}" target="_blank" rel="noopener">Open full-screen ↗</a>
    </div>
  </aside>

  <div class="report-frame-wrap">
    <iframe
      name="reportFrame"
      src="/report/{{ run.run_id }}"
      title="{{ brand.name if brand else run.run_id }} audit report"
      loading="lazy"
    ></iframe>
  </div>
</div>

<script>
  // Highlight the clicked section in the sidebar.
  (function () {
    var links = document.querySelectorAll('#reportNav a');
    links.forEach(function (a) {
      a.addEventListener('click', function () {
        links.forEach(function (x) { x.classList.remove('active'); });
        a.classList.add('active');
      });
    });
  })();
</script>
{% endblock %}
