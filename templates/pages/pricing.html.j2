{% block extra_css %}
  .price-section { margin: 28px 0; }
  .price-section-label { display:inline-flex; align-items:center; gap:8px; padding:6px 12px; margin-bottom:16px; border-radius:999px; background:rgba(37,99,235,.08); color:#1d4ed8; font-size:12px; font-weight:900; letter-spacing:.06em; text-transform:uppercase; }
  .pricing-grid { display: grid; gap: 18px; }
  .pricing-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
  .pricing-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
  .price-card { position: relative; padding: 30px 26px; border-radius: 24px; background: white; border: 1px solid var(--line); box-shadow: var(--shadow-soft); display: flex; flex-direction: column; gap: 14px; }
  .price-card.featured { background: linear-gradient(160deg, #1d4ed8 0%, #4338ca 50%, #6d28d9 100%); color: white; transform: translateY(-4px); border: 1px solid rgba(255,255,255,.2); box-shadow: 0 30px 60px rgba(67,56,202,.32); }
  .price-card.featured .tagline, .price-card.featured li { color: rgba(255,255,255,.84); }
  .price-card.featured ul li::before { background: rgba(52,211,153,.2); color: #34d399; }
  .price-card.free { background: linear-gradient(160deg, #f8fafc 0%, #f1f5f9 100%); border-style: dashed; }
  .badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); padding: 5px 12px; border-radius: 999px; background: linear-gradient(135deg, #f59e0b, #f97316); color: white; font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; box-shadow: 0 8px 18px rgba(249,115,22,.32); }
  .tier-name { font-size: 13px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .price-card.featured .tier-name { color: rgba(255,255,255,.72); }
  .tier-price { font-size: 44px; font-weight: 900; line-height: 1; letter-spacing: -.05em; }
  .tier-price small { font-size: 14px; font-weight: 700; color: var(--muted); margin-left: 4px; }
  .price-card.featured .tier-price small { color: rgba(255,255,255,.6); }
  .tagline { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.45; min-height: 60px; }
  .feature-list { list-style: none; padding: 0; margin: 4px 0 0; display: grid; gap: 10px; }
  .feature-list li { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 1.5; color: var(--ink-2); }
  .price-card.featured .feature-list li { color: rgba(255,255,255,.92); }
  .feature-list li::before { content: "✓"; flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; background: #ecfdf5; color: var(--success); display: grid; place-items: center; font-weight: 900; font-size: 12px; }
  .tier-cta { display: inline-flex; align-items: center; justify-content: center; margin-top: auto; padding: 14px 22px; border-radius: 999px; background: var(--ink); color: white; text-decoration: none; font-weight: 800; font-size: 15px; }
  .price-card.featured .tier-cta { background: white; color: #1d4ed8; box-shadow: 0 14px 28px rgba(0,0,0,.22); }
  .price-card.free .tier-cta { background: transparent; color: var(--ink); border: 1px solid var(--line); }

  .compare { width: 100%; border-collapse: separate; border-spacing: 0; margin-top: 16px; background: white; border: 1px solid var(--line); border-radius: 22px; overflow: hidden; }
  .compare th, .compare td { padding: 14px 18px; text-align: left; font-size: 14px; border-bottom: 1px solid var(--line); }
  .compare th { background: #f8fafc; font-weight: 800; color: var(--ink); font-size: 13px; }
  .compare td:not(:first-child) { text-align: center; font-variant-numeric: tabular-nums; }
  .compare tr:last-child td { border-bottom: 0; }
  .compare .yes { color: var(--success); font-weight: 800; }
  .compare .no { color: var(--soft-muted); }

  .faq-item { padding: 20px 22px; background: white; border: 1px solid var(--line); border-radius: 16px; margin-bottom: 10px; }
  .faq-item h4 { margin: 0 0 6px; font-size: 16px; }
  .faq-item p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.6; }

  @media (max-width: 930px) { .pricing-grid.cols-2, .pricing-grid.cols-3 { grid-template-columns: 1fr; } .price-card.featured { transform: none; } }
{% endblock %}

