{% extends "_layout.html.j2" %}
{% set active = 'pricing' %}
{% set canonical_path = "/pricing" %}
{% set page_description = "Four audit tiers from $29. Two Engine Audit $29 or full 5-engine $79 one-off. Monitoring from $35/mo. Free preview, no account required." %}
{% block title %}Pricing — monitoraeo (from $29){% endblock %}

{% block schema %}
