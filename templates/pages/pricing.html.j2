      "offers": {
        "@type": "Offer",
        "price": "79",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "{{ _base_url }}/pricing"
      }
    },
    {
      "@type": "Product",
      "@id": "{{ _base_url }}/pricing#two-engine-monthly",
      "name": "monitoraeo — Two Engine Monitoring",
