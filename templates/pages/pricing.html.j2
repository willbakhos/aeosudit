      "brand": { "@id": "{{ _base_url }}/#org" },
      "offers": {
        "@type": "Offer",
        "price": "35",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "{{ _base_url }}/pricing"
      }
    },
    {
      "@type": "Product",
      "@id": "{{ _base_url }}/pricing#full-monthly",
      "name": "monitoraeo — Full monitoring",
      "description": "Recurring monthly audit across all 5 AI engines, with per-engine trend charts and source change alerts.",
      "brand": { "@id": "{{ _base_url }}/#org" },
      "offers": {
        "@type": "Offer",
        "price": "95",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "{{ _base_url }}/pricing"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "{{ _base_url }}/pricing#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What's the difference between two-engine and full audit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Two Engine Audit ($29) tests Google AI Overviews and ChatGPT — the two engines most buyers actually use today. Full audit ($79) adds Claude, Perplexity and Gemini for complete coverage. Start with two-engine if you're cost-sensitive; pick full if you want to be sure you're not missing visibility in a less-mainstream engine."
