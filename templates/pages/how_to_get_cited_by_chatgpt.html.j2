<script>
(function(){
  var list = document.getElementById('guideTocList');
  if (!list) return;
  // Build TOC from every h2 inside the main content (excluding the
  // sidebar's own h3). Auto-IDs added for any h2 missing one.
  var headings = Array.prototype.slice.call(document.querySelectorAll('.guide-layout > div > h2'));
  if (!headings.length) { document.getElementById('guideToc').style.display = 'none'; return; }
  var entries = [];
  headings.forEach(function(h, i){
    if (!h.id) {
      h.id = 'sec-' + (h.textContent || ('section-' + i))
        .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40);
    }
    var li = document.createElement('li');
    var a = document.createElement('a');
    a.href = '#' + h.id;
    a.textContent = h.textContent;
    li.appendChild(a);
    list.appendChild(li);
    entries.push({h: h, a: a});
  });
  // Highlight the active section as the user scrolls
  function onScroll(){
    var y = window.scrollY + 120;
    var active = entries[0];
    for (var i = 0; i < entries.length; i++) {
      if (entries[i].h.offsetTop <= y) active = entries[i];
    }
    entries.forEach(function(e){ e.a.classList.toggle('active', e === active); });
  }
  window.addEventListener('scroll', onScroll, {passive: true});
  onScroll();
})();
</script>
