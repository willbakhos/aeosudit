{% extends "_layout.html.j2" %}
{% set canonical_path = "/guides" %}
{% set page_description = "monitoraeo guides: practical pillar pages on winning AI search visibility. Step-by-step playbooks for ChatGPT, Claude, Perplexity, Gemini and Google AI Overviews." %}
{% set page_og_type = 'website' %}
{% block title %}Guides: AEO + GEO playbooks | monitoraeo{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "{{ _canonical }}#page",
  "name": "monitoraeo guides",
  "description": "{{ page_description }}",
  "url": "{{ _canonical }}",
  "publisher": {"@id": "{{ _base_url }}/#org"},
  "inLanguage": "en",
  "hasPart": [
    {%- for g in guides %}
    {"@type": "Article", "name": {{ g.title|tojson }}, "url": "{{ _base_url }}/guides/{{ g.slug }}", "description": {{ g.summary|tojson }}}{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{% endblock %}

{% block extra_css %}
  .guides-hero { padding: 32px; border-radius: 24px; background: white; border: 1px solid var(--line); box-shadow: var(--shadow-soft); margin-bottom: 24px; }
  .guides-hero h1 { margin: 6px 0 10px; font-size: clamp(28px, 4vw, 40px); line-height: 1.08; letter-spacing: -.03em; }
  .guides-hero .lede { color: var(--muted); margin: 0; font-size: 15.5px; max-width: 720px; line-height: 1.6; }
  .guide-card { padding: 22px 24px; border-radius: 18px; background: white; border: 1px solid var(--line); box-shadow: var(--shadow-soft); margin-bottom: 14px; transition: border-color .15s; }
  .guide-card:hover { border-color: var(--blue); }
  .guide-card a { color: inherit; text-decoration: none; }
  .guide-card .meta { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; font-size: 11.5px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); }
  .guide-card .meta .tag { background: #f5f3ff; color: var(--purple); padding: 2px 8px; border-radius: 6px; }
  .guide-card h2 { margin: 0 0 8px; font-size: 21px; letter-spacing: -.02em; }
  .guide-card p { margin: 0; color: var(--ink-2); font-size: 14.5px; line-height: 1.55; }
{% endblock %}

{% block content %}
<section class="guides-hero">
  <span class="eyebrow">Knowledge base · Guides</span>
  <h1>Guides</h1>
  <p class="lede">Longer-form pillar pages on how to actually win AI search visibility. Each one is a complete playbook, not a glossary stub. For short definitional entries, see the <a href="/glossary" style="color:var(--blue); font-weight:700;">glossary</a>.</p>
</section>

{% for g in guides %}
<article class="guide-card">
  <a href="/guides/{{ g.slug }}">
    <div class="meta">
      <span class="tag">Guide</span>
      {% if g.minutes_read %}<span>{{ g.minutes_read }} min read</span>{% endif %}
    </div>
    <h2>{{ g.title }}</h2>
    <p>{{ g.summary }}</p>
  </a>
</article>
{% endfor %}

<p style="margin-top:32px; color:var(--muted); font-size:14px; text-align:center;">
  More guides coming. In the meantime, browse the
  <a href="/knowledge" style="color:var(--blue); font-weight:700;">full knowledge base</a>
  or the <a href="/glossary" style="color:var(--blue); font-weight:700;">glossary</a>.
</p>
{% endblock %}
