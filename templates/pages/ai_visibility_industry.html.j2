{% extends "_layout.html.j2" %}
{% set canonical_path = "/ai-visibility/" ~ report.slug %}
{% set _engine_name = engine_display_name or "Google AI" %}
{# Title + H1 lead with "AEO for <category>" so the page is unambiguously
   about Answer Engine Optimisation, which is the term monitoraeo can
   actually own in SERPs. The previous "Best <category> (2026)" framing
   competed against every commercial listicle in the category and pulled
   shoppers rather than AEO buyers. The year is deliberately dropped from
   the title and H1: the page is refreshed monthly, so a hardcoded year
   dates the page the moment the calendar turns and forces an annual
   sweep across 2400+ pages. Freshness is signalled by the visible
   "Last updated" byline plus schema dateModified instead.
   For local-service slugs (where detect_local_services found a city or
   state), swap "the brands" for "the providers" so the copy reads
   naturally for dermatologists/lawyers/dentists/etc. #}
{% set _noun = "providers" if local_meta else "brands" %}
{% set page_description = "AEO for " ~ report.name|sentence_lower ~ ": which " ~ _noun ~ " AI engines (ChatGPT, Claude, Perplexity, Gemini, Google AI) name and cite when buyers ask. " ~ (brands|length) ~ " ranked on answer engine visibility, refreshed monthly." %}
{% set page_og_type = 'article' %}
{% set page_published_time = report.created_at.strftime('%Y-%m-%dT%H:%M:%SZ') if report.created_at else '2026-01-15T00:00:00Z' %}
{% set page_modified_time = report.last_full_refresh.strftime('%Y-%m-%dT%H:%M:%SZ') if report.last_full_refresh else page_published_time %}
{# Empty-page guardrail: when no brand has scored any visibility/citation,
   refresh_industry sets report.noindex=True. We emit noindex,follow so
   Google still crawls (the next refresh may produce data) but doesn't
   keep an empty page in the index. Same flag drives sitemap exclusion. #}
{% if report.noindex %}{% set page_robots = "noindex,follow" %}{% endif %}
{# Narrative cache from refresh_industry — empty dict {} for pre-narrative
   rows. Each conditional below falls back to bare table when missing. #}
{% set narrative = report.narrative or {} %}
{% set narrative_paragraphs = narrative.get('narrative_paragraphs', []) %}
{% set brand_insights = narrative.get('brand_insights', []) %}
{% set narrative_faqs = narrative.get('faqs', []) %}
{% set movers = narrative.get('movers', {}) %}
{% set risers = movers.get('risers', []) %}
{% set fallers = movers.get('fallers', []) %}
{# Lookup table so we can attach an insight inline next to the top brand
   rows. Prefer AI-written narrative insights when present; fall back to
   the deterministic auto_brand_insights computed in the route from the
   raw scores so the page never reads bare. #}
{% set insight_by_brand = dict(auto_brand_insights or {}) %}
{% for bi in brand_insights %}{% set _ = insight_by_brand.update({bi.brand_name|lower: bi.text}) %}{% endfor %}
{# Canonical page name, reused by the H1, the share buttons and every
   JSON-LD headline below so they can never drift out of sync. #}
{% set _page_name = "AEO for " ~ report.name|sentence_lower ~ ": AI search visibility ranking" %}
{% block title %}AEO for {{ report.name }}: which {{ _noun }} AI search recommends | monitoraeo{% endblock %}
{# Explicit og_title. Without this the layout falls back to self.title(),
   which drags the " | monitoraeo" suffix into Slack/LinkedIn/X previews
   and pushes the useful half of the headline out of the card. #}
{% block og_title %}{{ _page_name }}{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dataset",
      "@id": "{{ _canonical }}#dataset",
      "name": "{{ _page_name }}",
      "description": "Answer engine optimisation (AEO) ranking for {{ report.name|sentence_lower }}: how AI search engines rank the category by visibility and citations. Per-brand visibility, citation rate and per-engine breakdown for {{ brands|length }} brands, audited via {{ _engine_name }} on an 8-query buyer-intent set, refreshed every {{ report.refresh_interval_days }} days.",
      "url": "{{ _canonical }}",
      "creator": { "@id": "{{ _base_url }}/#org" },
      "publisher": { "@id": "{{ _base_url }}/#org" },
      "datePublished": "{{ page_published_time }}",
      "dateModified": "{{ page_modified_time }}",
      "inLanguage": "en",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "isAccessibleForFree": true,
      "keywords": ["AEO for {{ report.name|sentence_lower }}", "{{ report.name }} AEO ranking", "{{ report.name }} AI search visibility", "AI visibility ranking {{ report.name|sentence_lower }}", "{{ report.name }} citation rate AI", "answer engine optimisation", "AEO", "{{ _engine_name }}"],
      "variableMeasured": [
        {"@type": "PropertyValue", "name": "Visibility", "description": "Percentage of AI answers that name the brand in the prose"},
        {"@type": "PropertyValue", "name": "Citation rate", "description": "Percentage of AI answers that cite the brand's domain as a source"},
        {"@type": "PropertyValue", "name": "Composite visibility score", "description": "0-100 composite weighting visibility 70% and citation rate 30%"}
      ]
    }
    {%- if brands %},
    {
      "@type": "ItemList",
      "@id": "{{ _canonical }}#ranking",
      "name": "{{ report.name }} ranked by AEO performance (AI search visibility)",
      "itemListOrder": "https://schema.org/ItemListOrderDescending",
      "numberOfItems": {{ brands|length }},
      "itemListElement": [
        {%- for b in brands %}
          {%- if not loop.first %},{% endif %}
        {
          "@type": "ListItem",
          "position": {{ b.rank_in_industry or loop.index }},
          "item": {
            "@type": "{{ local_meta.schema_type if local_meta else 'Organization' }}",
            "name": {{ b.brand_name|tojson }}
            {%- if b.brand_domain %},
            "url": "https://{{ b.brand_domain }}"
            {%- endif %}
            {%- if local_meta %},
            "areaServed":
            {%- if local_meta.area_type == 'State' %}
              {
                "@type": "State",
                "name": {{ local_meta.state_full|tojson }}
                {%- if local_meta.state_abbr %},
                "alternateName": {{ local_meta.state_abbr|tojson }}
                {%- endif %}
              }
            {%- else %}
              {
                "@type": "City",
                "name": {{ local_meta.city_name|tojson }}
                {%- if local_meta.state_full %},
                "containedInPlace": {
                  "@type": "State",
                  "name": {{ local_meta.state_full|tojson }}
                  {%- if local_meta.state_abbr %},
                  "alternateName": {{ local_meta.state_abbr|tojson }}
                  {%- endif %}
                }
                {%- endif %}
              }
            {%- endif %}
            {%- endif %}
          }
        }
        {%- endfor %}
      ]
    }
    {%- endif %},
    {
      "@type": "Article",
      "@id": "{{ _canonical }}#article",
      "headline": "{{ _page_name }}",
      "description": "{{ page_description }}",
      "url": "{{ _canonical }}",
      "mainEntityOfPage": "{{ _canonical }}",
      "author": { "@id": "{{ _base_url }}/#org" },
      "publisher": { "@id": "{{ _base_url }}/#org" },
      "image": "{{ _og_image }}",
      "datePublished": "{{ page_published_time }}",
      "dateModified": "{{ page_modified_time }}",
      "inLanguage": "en"
    }
    {%- if narrative_faqs %},
    {
      "@type": "FAQPage",
      "@id": "{{ _canonical }}#faq",
      "mainEntity": [
        {%- for f in narrative_faqs %}
          {%- if not loop.first %},{% endif %}
        {
          "@type": "Question",
          "name": {{ f.q|tojson }},
          "acceptedAnswer": {"@type": "Answer", "text": {{ f.a|tojson }}}
        }
        {%- endfor %}
      ]
    }
    {%- endif %}
  ]
}
</script>
{% endblock %}

{% block extra_css %}
  /* Share + Download action row — drops out of the PDF render via @media print. */
  .actions-row { display: flex; gap: 8px; flex-wrap: wrap; margin: 18px 0 0; align-items: center; }
  .action-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line);
    background: white; color: var(--ink); font-size: 13px; font-weight: 700;
    text-decoration: none; cursor: pointer; transition: all .15s;
  }
  .action-btn:hover { border-color: var(--blue); color: var(--blue); }
  .action-btn.primary { background: var(--blue); color: white; border-color: var(--blue); }
  .action-btn.primary:hover { background: #1e40af; border-color: #1e40af; color: white; }
  .action-btn.copied { background: #dcfce7; color: #15803d; border-color: #86efac; }
  .action-btn svg { width: 14px; height: 14px; }
  /* Disabled / loading state — needed because the submit button gets
     disabled while the PDF render+send runs (~6-8s). Without these
     styles it looked identical to a fresh click target and users were
     double-submitting. */
  .action-btn:disabled, .action-btn.is-loading {
    opacity: .6; cursor: not-allowed; pointer-events: none;
  }
  .action-btn.is-loading::before {
    content: ""; display: inline-block;
    width: 12px; height: 12px;
    border: 2px solid currentColor; border-right-color: transparent;
    border-radius: 50%;
    margin-right: 8px; vertical-align: -2px;
    animation: pdfm-spin .7s linear infinite;
  }
  @keyframes pdfm-spin { to { transform: rotate(360deg); } }

  /* Email-gate modal for PDF download. */
  .pdfm-backdrop {
    display: none; position: fixed; inset: 0; background: rgba(15,23,42,.55);
    z-index: 100; align-items: center; justify-content: center; padding: 20px;
  }
  .pdfm-backdrop.open { display: flex; }
  .pdfm-card {
    background: white; border-radius: 20px; padding: 28px; max-width: 460px;
    width: 100%; box-shadow: 0 25px 50px -12px rgba(0,0,0,.25);
  }
  .pdfm-card h3 { margin: 0 0 8px; font-size: 20px; letter-spacing: -.02em; }
  .pdfm-card p { margin: 0 0 18px; color: var(--muted); font-size: 14px; line-height: 1.55; }
  .pdfm-card input[type=email] {
    width: 100%; padding: 12px 14px; border-radius: 12px;
    border: 1.5px solid var(--line); font-size: 15px; box-sizing: border-box;
    font-family: inherit;
  }
  .pdfm-card input[type=email]:focus { outline: none; border-color: var(--blue); }
  .pdfm-actions { display: flex; gap: 8px; margin-top: 14px; }
  .pdfm-actions .action-btn { flex: 1; justify-content: center; }
  .pdfm-status { margin-top: 12px; font-size: 13px; line-height: 1.5; }
  .pdfm-status.ok { color: #15803d; }
  .pdfm-status.err { color: #b91c1c; }
  .pdfm-consent { font-size: 12px; color: var(--muted); margin-top: 10px; line-height: 1.5; }

  @media print {
    .actions-row, .pdfm-backdrop, nav, .site-footer, .footer,
    .faq-block, #cookieBar, .cc-bar { display: none !important; }
    body { padding: 0 !important; }
    .ind-hero, .glance-card, .narrative-section { box-shadow: none !important; }
  }

  .ind-hero { padding: 32px; border-radius: 24px; background: white; border: 1px solid var(--line); box-shadow: var(--shadow-soft); margin-bottom: 24px; }
  .ind-hero h1 { margin: 6px 0 10px; font-size: clamp(28px, 4vw, 42px); line-height: 1.08; letter-spacing: -.04em; }
  .ind-hero .lede { color: var(--muted); margin: 0 0 16px; font-size: 15.5px; max-width: 720px; line-height: 1.6; }
  .ind-hero .updated-pill { display: inline-flex; align-items: center; gap: 7px; padding: 5px 11px; border-radius: 999px; background: rgba(16,185,129,.10); color: #15803d; font-size: 12px; font-weight: 700; }
  .ind-hero .updated-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: #16a34a; }
  .ind-hero .ind-byline {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 8px; margin: 0 0 14px;
    font-size: 13.5px; color: var(--muted); font-weight: 500;
  }
  .ind-hero .ind-byline a { color: var(--ink); font-weight: 700; text-decoration: none; border-bottom: 1px dashed var(--line); }
  .ind-hero .ind-byline a:hover { color: var(--blue); border-bottom-color: var(--blue); }
  .ind-hero .ind-byline time { font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
  .ind-hero .ind-byline span[aria-hidden] { color: var(--soft-muted); }
  .ind-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 16px; }
  .ind-stat { padding: 14px 16px; background: #f8fafc; border-radius: 14px; border: 1px solid var(--line); }
  .ind-stat .n { font-size: 24px; font-weight: 900; letter-spacing: -.04em; line-height: 1; color: var(--ink); }
  .ind-stat .l { color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin-top: 6px; }

  .glance-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 18px 0 8px; }
  .glance-card { padding: 16px 18px; background: white; border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow-soft); }
  .glance-card .label { display: block; font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin-bottom: 6px; }
  .glance-card .value { display: block; font-size: 18px; font-weight: 900; color: var(--ink); letter-spacing: -.02em; line-height: 1.25; }
  .glance-card .value strong { color: var(--blue); }
  .glance-card .sub { display: block; font-size: 12px; color: var(--muted); margin-top: 4px; line-height: 1.4; }

  .insight-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 14px; }
  .insight-card { padding: 18px 20px; background: white; border: 1px solid var(--line); border-radius: 16px; }
  .insight-card h4 { margin: 0 0 6px; font-size: 14px; color: var(--ink); }
  .insight-card p { margin: 0; color: var(--muted); font-size: 13.5px; line-height: 1.6; }
  .insight-card p em { color: var(--ink-2); font-style: normal; font-weight: 700; }

  .narrative-section { margin: 28px 0; padding: 26px 28px; background: white; border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow-soft); }
  .narrative-section h2 { margin: 0 0 12px; font-size: 22px; letter-spacing: -.025em; }
  .narrative-section p { font-size: 15.5px; line-height: 1.75; color: var(--ink-2); margin: 0 0 14px; }
  .narrative-section p:last-child { margin-bottom: 0; }

  .rank-table { width: 100%; border-collapse: separate; border-spacing: 0; background: white; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; box-shadow: var(--shadow-soft); }
  .rank-table thead th { background: #f8fafc; font-size: 12px; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; padding: 14px 16px; text-align: left; border-bottom: 1px solid var(--line); }
  .rank-table thead th.num { text-align: right; }
  .rank-table td { padding: 14px 16px; border-bottom: 1px solid var(--line); font-size: 14.5px; vertical-align: middle; }
  .rank-table tr:last-child td { border-bottom: 0; }
  .rank-table td.rank { font-weight: 900; color: var(--blue); font-variant-numeric: tabular-nums; width: 52px; }
  .rank-table td.brand-cell { font-weight: 800; color: var(--ink); }
  .rank-table td.brand-cell .brand-name { display: block; font-weight: 800; color: var(--ink); }
  .rank-table td.brand-cell .brand-name a { color: var(--ink); text-decoration: none; border-bottom: 1px dashed transparent; }
  .rank-table td.brand-cell .brand-name a:hover { color: var(--blue); border-bottom-color: var(--blue); }
  .rank-table td.brand-cell .dom { display: block; font-weight: 500; color: var(--muted); font-size: 12px; margin-top: 2px; line-height: 1.3; }
  .rank-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .rank-table td .bar-wrap { display: inline-block; width: 80px; height: 6px; border-radius: 999px; background: rgba(15,23,42,.06); margin-right: 8px; vertical-align: middle; overflow: hidden; }
  .rank-table td .bar { display: block; height: 100%; background: linear-gradient(90deg, var(--blue), var(--purple)); border-radius: 999px; }
  .rank-table td.engine-tag { color: var(--ink-2); font-size: 13px; }
  .rank-table tr.top-1 td.brand-cell, .rank-table tr.top-1 td.rank { color: var(--success); }
  .rank-table tr.insight-row td { border-bottom: 1px solid var(--line); padding: 10px 16px 14px 70px; background: #f8fafc; }
  .rank-table tr.insight-row td p { margin: 0; color: var(--ink-2); font-size: 13.5px; line-height: 1.55; font-weight: 500; }

  .source-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
  .source-pills span { font-size: 12px; padding: 5px 10px; background: white; border: 1px solid var(--line); border-radius: 999px; color: var(--ink-2); font-weight: 600; }

  .movers-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 14px; }
  .mover-card { padding: 18px 20px; border-radius: 16px; background: white; border: 1px solid var(--line); box-shadow: var(--shadow-soft); }
  .mover-card.up { border-left: 4px solid var(--success); }
  .mover-card.down { border-left: 4px solid var(--danger); }
  .mover-card h4 { margin: 0 0 4px; font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  .mover-card ul { list-style: none; padding: 0; margin: 6px 0 0; }
  .mover-card li { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 10px; padding: 8px 0; border-bottom: 1px dashed var(--line); }
  .mover-card li:last-child { border-bottom: 0; }
  .mover-card .b { font-weight: 800; color: var(--ink); font-size: 14px; }
  .mover-card .d { font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .mover-card.up .d { color: var(--success); }
  .mover-card.down .d { color: var(--danger); }
  .mover-card .r { display: block; color: var(--muted); font-size: 11.5px; font-weight: 500; margin-top: 2px; }

  .buyer-intro {
    margin: 24px 0 28px; padding: 22px 26px;
    background: white; border: 1px solid var(--line); border-left: 4px solid var(--blue);
    border-radius: 14px; box-shadow: var(--shadow-soft);
  }
  .buyer-intro p {
    font-size: 16px; line-height: 1.7; color: var(--ink-2);
    margin: 0 0 14px;
  }
  .buyer-intro p:first-child { font-size: 17px; color: var(--ink); font-weight: 500; }
  .buyer-intro p:last-child { margin-bottom: 0; }
  .related-concepts { margin-top: 36px; padding: 24px 28px; border-radius: 18px; background: white; border: 1px solid var(--line); box-shadow: var(--shadow-soft); }
  .related-concepts h2 { margin: 0 0 10px; font-size: 18px; }
  .related-concepts-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .related-concepts-list li { padding: 10px 0; border-bottom: 1px dashed var(--line); }
  .related-concepts-list li:last-child { border-bottom: 0; }
  .related-concepts-list li a { font-weight: 800; color: var(--ink); text-decoration: none; border-bottom: 1px dashed transparent; }
  .related-concepts-list li a:hover { color: var(--blue); border-bottom-color: var(--blue); }
  .related-concepts-list .rcd { display: block; color: var(--muted); font-size: 13px; font-weight: 500; margin-top: 2px; line-height: 1.5; }

  @media (max-width: 720px) {
    .ind-stats, .movers-grid, .insight-cards { grid-template-columns: 1fr; }
    .glance-grid { grid-template-columns: 1fr 1fr; }
    .rank-table { display: block; overflow-x: auto; }
    .rank-table tr.insight-row td { padding-left: 16px; }
    .related-concepts { padding: 18px 20px; }
  }
{% endblock %}

{% block content %}
<section class="ind-hero">
  <span class="eyebrow">AEO Rankings · {{ report.parent_category or 'Industry' }}</span>
  <h1>{{ _page_name }}</h1>
  {# Byline. Renders both published + updated so the date signal is
     visible in-page (matches the Article schema dateModified above) and
     nudges SERP snippets toward showing a fresh date. Aria-hidden dot
     separator keeps screen-reader output clean. #}
  <p class="ind-byline">
    <span class="ind-byline-author">By <a href="/">monitoraeo</a></span>
    <span aria-hidden="true">·</span>
    {% if report.last_full_refresh %}
      <span>Last updated <time datetime="{{ report.last_full_refresh.strftime('%Y-%m-%d') }}">{{ report.last_full_refresh.strftime('%B %d, %Y') }}</time></span>
    {% else %}
      <span>First audit running</span>
    {% endif %}
    <span aria-hidden="true">·</span>
    <span>Refreshed every {{ report.refresh_interval_days }} days</span>
  </p>
  <p class="lede">How AI search engines rank {{ report.name|sentence_lower }} by <a href="/glossary/visibility-metric" style="color:inherit;">visibility</a> and <a href="/glossary/citation-rate-meaning" style="color:inherit;">citations</a>. {{ brands|length }} {{ _noun }} measured monthly across {{ _engine_name }}: which {{ _noun }} the AI names in answers, which domains it cites as sources, and how the leaders compare.{% if report.description %} {{ report.description }}{% endif %} Composite score: <strong>70% <a href="/glossary/visibility-metric" style="color:inherit;">visibility</a></strong> (% of AI answers naming the brand) + <strong>30% <a href="/glossary/citation-rate-meaning" style="color:inherit;">citation rate</a></strong> (% citing the brand's domain). <a href="/ai-visibility/methodology" style="color:var(--blue); font-weight:700;">Full methodology →</a></p>
  <div class="ind-stats">
    <div class="ind-stat"><div class="n">{{ '%.0f' % avg_visibility }}%</div><div class="l">Avg visibility across category</div></div>
    <div class="ind-stat"><div class="n">{{ '%.0f' % avg_citation }}%</div><div class="l">Avg citation rate</div></div>
    <div class="ind-stat"><div class="n">{{ audited_count }}/{{ brands|length }}</div><div class="l">Brands successfully audited</div></div>
  </div>
  {% if not pdf %}
  {# Action row — share + PDF download. Dropped entirely when rendering
     for the email-gated PDF (pdf=True context flag). #}
  {% set _share_title = _page_name %}
  {% set _share_url = _canonical %}
  {% set _x_intent = 'https://twitter.com/intent/tweet?text=' ~ (_share_title ~ ' — via @monitoraeo')|urlencode ~ '&url=' ~ _share_url|urlencode %}
  {% set _li_intent = 'https://www.linkedin.com/sharing/share-offsite/?url=' ~ _share_url|urlencode %}
  <div class="actions-row" id="actionsRow">
    <button class="action-btn" id="shareNativeBtn" type="button" data-share-url="{{ _share_url }}" data-share-title="{{ _share_title }}" style="display:none;" aria-label="Share">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      Share
    </button>
    <a class="action-btn" href="{{ _x_intent }}" target="_blank" rel="noopener" aria-label="Share on X">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2H21l-6.54 7.47L22 22h-6.84l-4.78-6.25L4.8 22H2l7.01-8.01L2 2h6.92l4.32 5.71L18.24 2zm-1.2 18.4h1.88L7.05 3.5H5.04l12 16.9z"/></svg>
      X
    </a>
    <a class="action-btn" href="{{ _li_intent }}" target="_blank" rel="noopener" aria-label="Share on LinkedIn">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 18.34V10.4H5.67v7.94h2.67zM7 9.28a1.55 1.55 0 1 0 0-3.1 1.55 1.55 0 0 0 0 3.1zm11.34 9.06v-4.35c0-2.33-1.24-3.41-2.9-3.41a2.5 2.5 0 0 0-2.27 1.25v-1.07h-2.67c.04.76 0 7.94 0 7.94h2.67v-4.43c0-.24.02-.48.09-.65a1.46 1.46 0 0 1 1.37-.98c.97 0 1.36.74 1.36 1.82v4.24h2.65z"/></svg>
      LinkedIn
