{% if not pdf %}
<div class="pdfm-backdrop" id="pdfmBackdrop" role="dialog" aria-modal="true" aria-labelledby="pdfmTitle">
  <div class="pdfm-card">
    <h3 id="pdfmTitle">Download this AEO ranking as a PDF</h3>
    <p>We'll email it to you. One-off send — no list, no follow-up, no surprise marketing.</p>
    <form id="pdfmForm" autocomplete="off">
      <input type="email" id="pdfmEmail" placeholder="you@yourbrand.com" required autocomplete="email">
      <div class="pdfm-actions">
        <button type="button" class="action-btn" id="pdfmCancel">Cancel</button>
        <button type="submit" class="action-btn primary" id="pdfmSubmit">Send me the PDF</button>
      </div>
      <div class="pdfm-status" id="pdfmStatus" aria-live="polite"></div>
      <p class="pdfm-consent">
        By submitting, you confirm you want to receive this PDF at the address above.
        See our <a href="/privacy" style="color:var(--muted);">privacy policy</a>.
      </p>
    </form>
  </div>
</div>

<script>
(function(){
  // Native Web Share (mobile + Chrome desktop). If available, surface the
  // native button — otherwise leave it hidden and rely on the dedicated
  // social buttons + copy link.
  var nativeBtn = document.getElementById('shareNativeBtn');
  if (nativeBtn && navigator.share) {
    nativeBtn.style.display = '';
    nativeBtn.addEventListener('click', function(){
      navigator.share({
        title: nativeBtn.dataset.shareTitle,
        text: nativeBtn.dataset.shareTitle,
        url: nativeBtn.dataset.shareUrl,
      }).catch(function(){ /* user dismissed */ });
    });
  }
  // Copy link to clipboard with visible "Copied!" feedback for 2s.
  var copyBtn = document.getElementById('copyLinkBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', function(){
      var url = copyBtn.dataset.copyUrl;
      var label = copyBtn.querySelector('.copy-label');
      var done = function(){
        copyBtn.classList.add('copied');
        if (label) label.textContent = 'Copied!';
        setTimeout(function(){
          copyBtn.classList.remove('copied');
          if (label) label.textContent = 'Copy link';
        }, 2000);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done, function(){
          window.prompt('Copy this link:', url);
        });
      } else {
        window.prompt('Copy this link:', url);
      }
    });
  }
  // PDF download modal.
  var openBtn = document.getElementById('downloadPdfBtn');
  var modal = document.getElementById('pdfmBackdrop');
  var cancelBtn = document.getElementById('pdfmCancel');
  var form = document.getElementById('pdfmForm');
  var emailIn = document.getElementById('pdfmEmail');
  var submitBtn = document.getElementById('pdfmSubmit');
  var statusEl = document.getElementById('pdfmStatus');
  function closeModal(){
    if (!modal) return;
    modal.classList.remove('open');
    if (statusEl) { statusEl.textContent = ''; statusEl.className = 'pdfm-status'; }
    // Reset the submit button so it's ready if the user reopens the modal.
    // The original text is captured in submitOrigText below the form handler;
    // restore here so the "Sent ✓" text from a successful run doesn't stick.
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.classList.remove('is-loading');
      submitBtn.textContent = 'Send me the PDF';
    }
  }
  if (openBtn && modal) {
    openBtn.addEventListener('click', function(){
      modal.classList.add('open');
      setTimeout(function(){ emailIn && emailIn.focus(); }, 50);
    });
  }
  if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
  if (modal) modal.addEventListener('click', function(e){
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && modal && modal.classList.contains('open')) closeModal();
  });
  if (form) {
    var submitOrigText = submitBtn ? submitBtn.textContent : '';
    var setLoading = function(loading) {
      if (!submitBtn) return;
      submitBtn.disabled = loading;
      submitBtn.classList.toggle('is-loading', loading);
      submitBtn.textContent = loading ? 'Sending…' : submitOrigText;
    };
    form.addEventListener('submit', function(e){
      e.preventDefault();
      if (!emailIn || !statusEl || !submitBtn) return;
      // Re-entry guard: if a previous submit is in flight (button is
      // already disabled / loading) drop the event entirely. Browsers
      // can re-fire submit on Enter-key from a focused field even when
      // the button is disabled.
      if (submitBtn.disabled) return;
      var email = (emailIn.value || '').trim().toLowerCase();
      if (!email || email.indexOf('@') < 0) {
        statusEl.className = 'pdfm-status err';
        statusEl.textContent = 'Please enter a valid email.';
        return;
      }
      setLoading(true);
      statusEl.className = 'pdfm-status';
      statusEl.textContent = '';
      fetch('/api/industry-pdf-request', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({email: email, slug: {{ report.slug|tojson }}})
      }).then(function(r){
        return r.json().then(function(body){ return {ok: r.ok, status: r.status, body: body}; });
      }).then(function(r){
        if (r.ok) {
          statusEl.className = 'pdfm-status ok';
          statusEl.textContent = '✓ Check your inbox — the PDF will arrive in the next minute.';
          // Leave the button in its loading state until the modal closes
          // so there's no flash back to an active-looking button.
          if (submitBtn) submitBtn.textContent = 'Sent ✓';
          setTimeout(closeModal, 3500);
        } else {
          setLoading(false);
          statusEl.className = 'pdfm-status err';
          statusEl.textContent = (r.body && r.body.detail) || 'Something went wrong. Please try again.';
        }
      }).catch(function(){
        setLoading(false);
        statusEl.className = 'pdfm-status err';
        statusEl.textContent = 'Network error. Please try again.';
      });
    });
  }
})();
</script>
{% endif %}

{# Buyer-intent intro — 2-3 short paragraphs aimed at someone evaluating
   brands in this category (not at someone evaluating monitoraeo). Sits
   ABOVE 'At a glance' so the first thing a buyer landing from Google
   reads is buyer-shaped, not methodology. Populated by
   industry_narrative.generate_buyer_intro() during refresh_industry.
   When missing (first refresh of a new industry, or LLM failure) we
   render nothing and fall straight through to "At a glance" as before. #}
{% set buyer_intro = report.buyer_intro or {} %}
{% set buyer_paragraphs = buyer_intro.get('paragraphs', []) %}
{% if buyer_paragraphs %}
<section class="buyer-intro">
  {% for para in buyer_paragraphs %}<p>{{ para }}</p>{% endfor %}
</section>
{% endif %}

{# At a glance — programmatic factual highlights from the actual audit
   data. Always renders (no LLM dependency) so the page has unique,
   per-industry content even when the AI narrative hasn't generated yet. #}
{% if quick_insights and quick_insights.leader %}
<h2 style="margin-top:32px;">At a glance</h2>
<div class="glance-grid">
  <div class="glance-card">
    <span class="label">Category leader</span>
    <span class="value"><strong>{{ quick_insights.leader.brand_name }}</strong></span>
    <span class="sub">{{ '%.0f' % quick_insights.leader.visibility_pct }}% visibility · named in {{ ((quick_insights.leader.visibility_pct / 12.5) | round | int) }} of 8 AI answers</span>
  </div>
  {% if quick_insights.most_cited_brand %}
  <div class="glance-card">
    <span class="label">Most cited brand</span>
    <span class="value"><strong>{{ quick_insights.most_cited_brand.brand_name }}</strong></span>
    <span class="sub">{{ '%.0f' % quick_insights.most_cited_brand.citation_pct }}% citation rate · the AI's most-trusted source brand in {{ report.name|sentence_lower }}</span>
  </div>
  {% endif %}
  {% if quick_insights.top_source_domain %}
  <div class="glance-card">
    <span class="label">Top cited domain</span>
    <span class="value"><strong>{{ quick_insights.top_source_domain }}</strong></span>
    <span class="sub">Referenced by AI across the {{ report.name|sentence_lower }} query set — the highest-leverage PR target in this category</span>
  </div>
  {% endif %}
  <div class="glance-card">
    <span class="label">Visibility spread</span>
    <span class="value"><strong>{{ '%.0f' % quick_insights.visibility_spread }}pp</strong></span>
    <span class="sub">Gap between top and bottom of the ranking{% if quick_insights.zero_visibility_count %} · {{ quick_insights.zero_visibility_count }} brand{{ '' if quick_insights.zero_visibility_count == 1 else 's' }} at 0% (invisible to the AI){% endif %}</span>
  </div>
</div>
{% endif %}

{% if narrative_paragraphs %}
<section class="narrative-section">
  <h2>What we observed in this category</h2>
  {% for para in narrative_paragraphs %}<p>{{ para }}</p>{% endfor %}
</section>
{% endif %}

{% if risers or fallers %}
<h2>Movers &amp; shakers since last refresh</h2>
<div class="movers-grid">
  {% if risers %}
  <div class="mover-card up">
    <h4>Biggest visibility risers</h4>
    <ul>
      {% for m in risers %}
      <li>
        <div>
          <span class="b">{{ m.brand_name }}</span>
          <span class="r">{{ '%.0f' % m.previous_visibility }}% → {{ '%.0f' % m.current_visibility }}% · rank #{{ m.previous_rank }} → #{{ m.current_rank }}</span>
        </div>
        <span class="d">+{{ '%.0f' % m.visibility_delta }}pp</span>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if fallers %}
  <div class="mover-card down">
    <h4>Biggest visibility fallers</h4>
    <ul>
      {% for m in fallers %}
      <li>
        <div>
          <span class="b">{{ m.brand_name }}</span>
          <span class="r">{{ '%.0f' % m.previous_visibility }}% → {{ '%.0f' % m.current_visibility }}% · rank #{{ m.previous_rank }} → #{{ m.current_rank }}</span>
        </div>
        <span class="d">{{ '%.0f' % m.visibility_delta }}pp</span>
      </li>
      {% endfor %}
    </ul>
