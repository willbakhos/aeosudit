<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
{% if traffic_source %}
<!-- Campaign attribution — pushed before GTM loads so tag triggers see it -->
<script>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    'event': 'campaign_attribution',
    'traffic_source': {{ traffic_source | tojson }},
    'traffic_medium': {{ traffic_medium | tojson }},
    'campaign_name': {{ traffic_campaign | tojson }}
  });
</script>
{% endif %}
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-5SSKHFCC');</script>
<!-- End Google Tag Manager -->
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Generating preview for {{ brand_name }}… | monitoraeo</title>
<meta name="robots" content="noindex,nofollow">
<link rel="icon" type="image/png" href="/static/favicon.png">
<link rel="apple-touch-icon" href="/static/favicon.png">
<style>
  :root {
    --ink:#0f172a; --muted:#64748b; --line:rgba(15,23,42,.10);
    --blue:#2563eb; --purple:#7c3aed; --cyan:#06b6d4; --success:#16a34a;
  }
  * { box-sizing: border-box; }
  html, body { overflow-x: clip; max-width: 100%; }
  body {
    margin: 0; min-height: 100vh; display: grid; place-items: center;
    color: var(--ink); padding: 28px;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    background:
      radial-gradient(circle at 8% 0%, rgba(37,99,235,.16), transparent 32rem),
      radial-gradient(circle at 85% 8%, rgba(124,58,237,.12), transparent 30rem),
      linear-gradient(180deg, #f8fbff 0%, #f8fafc 38%, #eef4ff 100%);
  }
  .topbar { position:absolute; top:24px; left:24px; }
  .topbar a { display:inline-flex; align-items:center; text-decoration:none; }
  .topbar img.wordmark { display:block; height:28px; width:auto; }

  .card {
    width: min(620px, 100%);
    background: rgba(255,255,255,.92); backdrop-filter: blur(12px);
    border-radius: 28px; padding: 44px 36px;
    border: 1px solid var(--line);
    box-shadow: 0 24px 70px rgba(15,23,42,.10);
  }

  .eyebrow {
    display: inline-flex; align-items: center; gap:6px;
    padding: 6px 12px; margin-bottom: 16px;
    border-radius: 999px;
    background: linear-gradient(135deg, #dbeafe, #ede9fe);
    color: #1d4ed8;
    font-size: 11px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase;
  }
  .eyebrow .dot { width:7px; height:7px; border-radius:50%; background:var(--blue); animation: pulse 1.4s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { opacity: .35; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.15); } }

  h1 {
    margin: 0 0 8px; font-size: 30px; line-height: 1.1; letter-spacing: -.04em; font-weight: 900;
  }
  h1 .brand-em { background: linear-gradient(135deg, var(--blue), var(--purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .lede { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.55; }
  .lede code { font-size: .9em; padding:2px 7px; border-radius:999px; background: rgba(37,99,235,.08); color:#1d4ed8; }

  .progress-shell { margin: 26px 0 14px; height: 10px; border-radius: 999px; background: #eef2f7; overflow: hidden; position: relative; }
  .progress-shell::after { content:""; position:absolute; inset:0; background: linear-gradient(90deg, transparent, rgba(255,255,255,.5), transparent); animation: shimmer 1.8s linear infinite; }
  @keyframes shimmer { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
  .progress-bar { height: 100%; width: 5%; border-radius: 999px;
    background: linear-gradient(90deg, var(--blue), var(--cyan));
    transition: width .8s cubic-bezier(.2, .8, .3, 1);
    position: relative; z-index: 1;
  }

  .step { display:flex; align-items:center; gap:10px; font-size: 14px; font-weight: 700; color: var(--ink); }
  .step .check { width:18px; height:18px; flex-shrink:0; border-radius:50%; border:2px solid #e2e8f0; display:grid; place-items:center; }
  .step.active .check { border-color: var(--blue); background: var(--blue); }
  .step.active .check::after { content:""; width:6px; height:6px; border-radius:50%; background:white; animation: pulse 1.4s ease-in-out infinite; }

  .meta { display:flex; gap:18px; align-items:center; flex-wrap:wrap; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  .meta .elapsed { font-variant-numeric: tabular-nums; font-weight: 700; color: var(--ink); }

  .err {
    margin-top: 18px; padding: 14px 16px;
    background: #fef2f2; color: #991b1b;
    border-radius: 14px; border: 1px solid #fecaca;
    font-size: 14px;
  }
  .err a { color: #991b1b; font-weight: 800; }

  @media (max-width: 620px) {
    body { padding: 14px; padding-top: 80px; align-items: flex-start; }
    .topbar { top: 18px; left: 18px; }
    .topbar img.wordmark { height: 24px; }
    .card { padding: 28px 22px; border-radius: 22px; }
    h1 { font-size: 24px; line-height: 1.18; }
    .lede { font-size: 14px; }
    .meta { flex-wrap: wrap; }
  }
</style>
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5SSKHFCC"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
  <header class="topbar">
    <a href="/" aria-label="monitoraeo home">
      <img class="wordmark" src="/static/monitoraeo-wordmark.png" alt="monitoraeo">
    </a>
  </header>

  <div class="card">
    <span class="eyebrow"><span class="dot"></span>Pulling your AI visibility data</span>
    <h1>Gathering data for <span class="brand-em">{{ brand_name }}</span>…</h1>
    <p class="lede">Compiling how Google AI Overviews answers 8 buyer-facing questions about <strong>{{ brand_name }}</strong>{% if domain %} (<code>{{ domain }}</code>){% endif %}{% if country_name %} for buyers in <strong>{{ country_name }}</strong>{% endif %} into your visibility report.</p>

    <div class="progress-shell"><div class="progress-bar" id="bar"></div></div>
    <div class="step active" id="step"><span class="check"></span><span id="step-text">Starting up…</span></div>

    <div class="meta">
      <span><span class="elapsed" id="elapsed">0s</span> elapsed</span>
      <span>·</span>
      <span>Usually finishes in 20–40 seconds</span>
    </div>

    <div class="err" id="err" style="display:none;"></div>
  </div>
<script>
  const runId = "{{ run_id }}";
  const bar = document.getElementById("bar");
  const stepText = document.getElementById("step-text");
  const elapsedEl = document.getElementById("elapsed");
  const err = document.getElementById("err");
  const startedAt = Date.now();
  const tickEvery = 1500;

  function fmtElapsed() {
    const s = Math.floor((Date.now() - startedAt) / 1000);
    elapsedEl.textContent = s + "s";
  }

  async function poll() {
    try {
      const r = await fetch(`/preview/${runId}/status`);
      const data = await r.json();
      if (data.status === "ready") {
        bar.style.width = "100%";
        stepText.textContent = "Done — opening your report…";
        fmtElapsed();
        setTimeout(() => window.location.href = `/report/${runId}`, 500);
        return;
      }
      if (data.status === "failed") {
        err.innerHTML = (data.error || "Something went wrong.") + ' <a href="/">Try again →</a>';
        err.style.display = "block";
        document.getElementById("step").style.display = "none";
        return;
      }
      // Use server-published step + pct, fallback to client-side time-based growth
      if (data.step) stepText.textContent = data.step;
      if (typeof data.pct === "number") {
        bar.style.width = Math.min(95, data.pct) + "%";
      } else {
        const ms = Date.now() - startedAt;
        bar.style.width = Math.min(90, 5 + (ms / 60000) * 85) + "%";
      }
      fmtElapsed();
      setTimeout(poll, tickEvery);
    } catch (e) {
      // Network blip — keep polling
      fmtElapsed();
      setTimeout(poll, tickEvery);
    }
  }
  fmtElapsed();
  setInterval(fmtElapsed, 1000);
  poll();
</script>
</body>
</html>
