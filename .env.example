OPENROUTER_API_KEY=
APIFY_TOKEN=
SCREENSHOTAPI_TOKEN=

# Stripe + delivery (only needed for src/server.py)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs — create matching products in your Stripe dashboard.
# One-off (mode=payment): two_engine ($29), full_audit ($79)
# Subscription (mode=subscription): two_engine_monthly ($25/mo), full_monthly ($75/mo)
STRIPE_PRICE_TWO_ENGINE=
STRIPE_PRICE_FULL_AUDIT=
STRIPE_PRICE_TWO_ENGINE_MONTHLY=
STRIPE_PRICE_FULL_MONTHLY=
PUBLIC_BASE_URL=http://localhost:8000

# Email (Resend)
RESEND_API_KEY=
REPORT_FROM_EMAIL=monitoraeo <reports@monitoraeo.com>
SUPPORT_TO_EMAIL=hello@monitoraeo.com

# Where audit runs are written. On Railway, point this at a mounted Volume
# (e.g. OUTPUT_ROOT=/app/output) so reports persist across deploys.
OUTPUT_ROOT=output

# monitor-dashboard (logged-in monitoring product)
# Supabase project — Auth (magic link) + Postgres for tracked brands and run history.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Postgres connection string for the same Supabase project. Use the pooler URL
# from Project Settings → Database → Connection pooling (transaction mode).
DATABASE_URL=
